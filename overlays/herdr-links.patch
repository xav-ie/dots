 };
 
+/// Every link on the viewport, as Ctrl-hover would classify the cell under the
+/// pointer. OSC 8 links group by destination in reading order, and a run of
+/// blank cells between two cells of one destination (an app's own wrap indent)
+/// does not split it. Plain text is probed at each word start.
+fn visible_links(
+    runtime: &crate::terminal::TerminalRuntime,
+) -> Vec<crate::api::schema::PaneLinkInfo> {
+    use crate::api::schema::{PaneLinkInfo, PaneLinkRegion};
+
+    let (rows, cols) = runtime.current_size();
+    let text = runtime.visible_text();
+    let grid: Vec<Vec<char>> = (0..rows)
+        .map(|row| {
+            text.lines()
+                .nth(usize::from(row))
+                .map(crate::app::actions::row_columns)
+                .unwrap_or_default()
+        })
+        .collect();
+    let blank = |row: u16, col: u16| {
+        grid.get(usize::from(row))
+            .and_then(|columns| columns.get(usize::from(col)))
+            .is_none_or(|ch| ch.is_whitespace())
+    };
+    let mut links: Vec<PaneLinkInfo> = Vec::new();
+    let mut covered = std::collections::HashSet::new();
+
+    let mut cells = runtime.visible_hyperlinks(ratatui::layout::Rect::new(0, 0, cols, rows));
+    cells.sort_by_key(|((x, y), _, _)| (*y, *x));
+    let mut last: Option<(u16, u16)> = None;
+    for ((x, y), _, uri) in cells {
+        covered.insert((y, x));
+        if crate::app::actions::safe_web_url(&uri).is_none() {
+            last = None;
+            continue;
+        }
+        let only_blanks_between = last.is_some_and(|(last_y, last_x)| {
+            let mut row = last_y;
+            let mut col = last_x + 1;
+            while (row, col) < (y, x) {
+                if col >= cols {
+                    row += 1;
+                    col = 0;
+                    continue;
+                }
+                if !blank(row, col) {
+                    return false;
+                }
+                col += 1;
+            }
+            true
+        });
+        match links.last_mut() {
+            Some(link) if only_blanks_between && link.url.as_deref() == Some(uri.as_str()) => {
+                match link.regions.last_mut() {
+                    Some(region) if region.row == y && region.end_col + 1 == x => {
+                        region.end_col = x;
+                    }
+                    _ => link.regions.push(PaneLinkRegion {
+                        row: y,
+                        start_col: x,
+                        end_col: x,
+                    }),
+                }
+            }
+            _ => links.push(PaneLinkInfo {
+                regions: vec![PaneLinkRegion {
+                    row: y,
+                    start_col: x,
+                    end_col: x,
+                }],
+                url: Some(uri),
+                path: None,
+            }),
+        }
+        last = Some((y, x));
+    }
+
+    for row in 0..rows {
+        let Some(columns) = grid.get(usize::from(row)) else {
+            continue;
+        };
+        for (col, ch) in columns.iter().enumerate() {
+            let col = col as u16;
+            let word_start = col == 0 || !columns[usize::from(col) - 1].is_alphanumeric();
+            if !word_start
+                || !(ch.is_alphanumeric() || matches!(ch, '~' | '.' | '/'))
+                || covered.contains(&(row, col))
+            {
+                continue;
+            }
+            let url_regions =
+                runtime.link_regions_at(col, row, crate::app::actions::url_byte_range);
+            let (regions, url, path) = if url_regions.is_empty() {
+                let (url, path) = match text_link_at(runtime, col, row) {
+                    Some(crate::app::actions::TextLink::Url(url)) => (Some(url), None),
+                    Some(crate::app::actions::TextLink::Path(path)) => (None, Some(path)),
+                    None => continue,
+                };
+                let regions =
+                    runtime.link_regions_at(col, row, crate::app::actions::token_byte_range);
+                (regions, url, path)
+            } else {
+                let url = runtime
+                    .link_target_at(col, row)
+                    .and_then(crate::app::actions::url_from_link_target);
+                (url_regions, url, None)
+            };
+            if regions.is_empty() || (url.is_none() && path.is_none()) {
+                continue;
+            }
+            for region in &regions {
+                for x in region.start_col..=region.end_col {
+                    covered.insert((region.row, x));
+                }
+            }
+            links.push(PaneLinkInfo { regions, url, path });
+        }
+    }
+    links
+}
