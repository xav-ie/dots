+                start_col: 1,
+                end_col: 3,
+            }],
+            url: Some("https://example.com/hovered".into()),
+            path: None,
+        }),
+    );
+    assert!(repaint);
+    let frame = state.compose(106, 20).unwrap();
+    let pane = &state.hits.panes[0];
+    let bottom = pane.inner_rect.y + pane.inner_rect.height - 1;
+    let cell = |col: u16| {
+        &frame.cells
+            [usize::from(bottom) * usize::from(frame.width) + usize::from(pane.inner_rect.x + col)]
+    };
+    // The fixture pane is four columns wide, so the URL is cut to fit.
+    let preview: String = (0..4).map(|col| cell(col).symbol.clone()).collect();
+    assert_eq!(preview, " h… ");
+    assert_ne!(cell(0).modifier & Modifier::REVERSED.bits(), 0);
+    assert_eq!(cell(0).hyperlink, None);
