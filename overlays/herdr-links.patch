+/// Shows the hovered link's destination in the pane's bottom-left corner, like a
+/// browser status bar. It moves to the top row when the link itself sits on the
+/// bottom one, and is skipped when the link covers both. A `warning` color marks
+/// links whose text names a different host, prefixing the destination with `≠`.
+fn render_link_preview(
+    frame: &mut FrameData,
+    occlusion: &mut crate::kitty_graphics::surface::Occlusion,
+    rect: Rect,
+    regions: &[PaneLinkRegion],
+    url: &str,
+    warning: Option<ratatui::style::Color>,
+) {
+    let width = usize::from(rect.width.min(frame.width.saturating_sub(rect.x)));
+    if width < 4 || rect.height < 2 {
+        return;
+    }
+    let Some(row) = [rect.height - 1, 0]
+        .into_iter()
+        .find(|row| regions.iter().all(|region| region.row != *row))
+        .map(|row| rect.y + row)
+        .filter(|row| *row < frame.height)
+    else {
+        return;
+    };
+    let shown = match warning {
+        Some(_) => format!("≠ {url}"),
+        None => url.to_owned(),
+    };
+    let mut text: Vec<char> = shown
+        .chars()
+        .map(|ch| match unicode_width::UnicodeWidthChar::width(ch) {
+            Some(1) => ch,
+            _ => '?',
+        })
+        .collect();
+    let room = width - 2;
+    if text.len() > room {
+        text.truncate(room - 1);
+        text.push('…');
+    }
+    let label: Vec<char> = std::iter::once(' ')
+        .chain(text)
+        .chain(std::iter::once(' '))
+        .collect();
+    occlusion.cover(Rect::new(rect.x, row, label.len() as u16, 1));
+    let blank = crate::protocol::CellData::from_ratatui_cell(&ratatui::buffer::Cell::new(" "));
+    let mut base = ratatui::buffer::Cell::new(" ");
+    if let Some(color) = warning {
+        base.set_fg(color);
+    }
+    let base = crate::protocol::CellData::from_ratatui_cell(&base);
+    let start = usize::from(row) * usize::from(frame.width) + usize::from(rect.x);
+    for (offset, ch) in label.iter().enumerate() {
+        if let Some(cell) = frame.cells.get_mut(start + offset) {
+            *cell = crate::protocol::CellData {
+                symbol: ch.to_string(),
+                modifier: Modifier::REVERSED.bits(),
+                ..base.clone()
+            };
+        }
+    }
+    // A wide glyph cut by the label's right edge would leave its spacer orphaned.
+    if let Some(cell) = frame
+        .cells
+        .get_mut(start + label.len())
+        .filter(|cell| cell.skip)
+    {
+        *cell = blank;
     }
 }
 
 fn region_contains(region: &PaneLinkRegion, col: u16, row: u16) -> bool {
     region.row == row && col >= region.start_col && col <= region.end_col
 }
