+/// A plain-text link that is not a visible `http(s)://` URL.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum TextLink {
+    /// A scheme-less `host.tld/path`, completed to `https://`.
+    Url(String),
+    /// An existing file or directory, made absolute. Any `:line[:col]` suffix
+    /// is kept so the copied text still points at the same spot.
+    Path(String),
+}
+
+/// Byte range of the whitespace-delimited token under `clicked_byte`, minus
+/// wrapping quotes and brackets and trailing sentence punctuation.
+pub(super) fn token_byte_range(text: &str, clicked_byte: usize) -> Option<std::ops::Range<usize>> {
+    if text.get(clicked_byte..)?.chars().next()?.is_whitespace() {
+        return None;
+    }
+    let start = text[..clicked_byte]
+        .rfind(char::is_whitespace)
+        .map_or(0, |index| {
+            index + text[index..].chars().next().map_or(1, char::len_utf8)
+        });
+    let end = text[clicked_byte..]
+        .find(char::is_whitespace)
+        .map_or(text.len(), |index| clicked_byte + index);
+    let token = &text[start..end];
+    let leading = token.len()
+        - token
+            .trim_start_matches(['"', '\'', '`', '(', '[', '<', '{'])
+            .len();
+    let trimmed = token.trim_end_matches([
+        '"', '\'', '`', ')', ']', '>', '}', '.', ',', ';', '!', '?', ':',
+    ]);
+    let range = start + leading..start + trimmed.len().max(leading);
+    (range.start < range.end && range.contains(&clicked_byte)).then_some(range)
+}
+
+/// Splits a trailing `:line` or `:line:col` off a path token.
+fn split_line_suffix(token: &str) -> (&str, &str) {
+    let mut path = token;
+    for _ in 0..2 {
+        match path.rsplit_once(':') {
+            Some((head, digits))
+                if !head.is_empty()
+                    && !digits.is_empty()
+                    && digits.chars().all(|ch| ch.is_ascii_digit()) =>
+            {
+                path = head;
+            }
+            _ => break,
+        }
+    }
+    (path, &token[path.len()..])
+}
+
+/// `https://` form of a scheme-less `host.tld/path` token.
+fn bare_web_url(token: &str) -> Option<String> {
+    let (host, path) = token.split_once('/')?;
+    let labels: Vec<&str> = host.split('.').collect();
+    let tld = labels.last()?;
+    let domain_shaped = labels.len() >= 2
+        && labels.iter().all(|label| {
+            !label.is_empty()
+                && label.starts_with(|ch: char| ch.is_ascii_alphanumeric())
+                && label.ends_with(|ch: char| ch.is_ascii_alphanumeric())
+                && label
+                    .chars()
+                    .all(|ch| ch.is_ascii_alphanumeric() || ch == '-')
+        })
+        && tld.len() >= 2
+        && tld.chars().all(|ch| ch.is_ascii_alphabetic());
+    (domain_shaped && !path.is_empty()).then(|| format!("https://{token}"))
+}
+
+/// Classifies the token under a click that is not a visible web URL: an
+/// existing path wins over a domain-shaped one, so `lib.rs/foo` on disk is
+/// copied rather than opened. Relative paths resolve against `cwd`, falling
+/// back to the server's own working directory.
+pub(crate) fn text_link_at(
+    text: &str,
+    clicked_byte: usize,
+    cwd: Option<&std::path::Path>,
+) -> Option<TextLink> {
+    let token = text.get(token_byte_range(text, clicked_byte)?)?;
+    let (path, suffix) = split_line_suffix(token);
+    if path.contains(['/', '.']) || path.starts_with('~') {
+        let resolved = if let Some(rest) = path.strip_prefix("~/") {
+            std::env::var_os("HOME").map(|home| std::path::Path::new(&home).join(rest))
+        } else if path == "~" {
+            std::env::var_os("HOME").map(std::path::PathBuf::from)
+        } else if std::path::Path::new(path).is_absolute() {
+            Some(std::path::PathBuf::from(path))
+        } else {
+            cwd.map(std::path::Path::to_path_buf)
+                .or_else(|| std::env::current_dir().ok())
+                .map(|base| base.join(path))
+        };
+        if let Some(resolved) = resolved.filter(|resolved| resolved.exists()) {
+            let absolute = std::path::absolute(&resolved).unwrap_or(resolved);
+            return Some(TextLink::Path(format!("{}{suffix}", absolute.display())));
+        }
+    }
+    bare_web_url(token).map(TextLink::Url)
+}
