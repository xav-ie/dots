+/// The character drawn at each display column of `row`; the second column of a
+/// wide character holds `'\0'`.
+pub(crate) fn row_columns(row: &str) -> Vec<char> {
+    let mut columns = Vec::new();
+    for cell in text_cells(row) {
+        let col = usize::from(cell.start_col);
+        if col < columns.len() {
+            continue;
+        }
+        columns.resize(col, ' ');
+        columns.push(cell.ch);
+        columns.resize(usize::from(cell.end_col) + 1, '\0');
+    }
+    columns
+}
