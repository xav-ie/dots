 use crate::app;
 use crate::protocol::{self, FrameData};
 
+/// Which sides of a zoomed tab's focused pane border other panes. Measured on a
+/// fixed area: split ratios alone decide the arrangement, and the tab's real
+/// size may be empty while no client is attached.
+fn zoom_sides(tab: &crate::workspace::Tab) -> protocol::ClientShellZoomSides {
+    if !tab.zoomed {
+        return protocol::ClientShellZoomSides::default();
+    }
+    let area = Rect::new(0, 0, 1000, 1000);
+    let focused = tab.layout.focused();
+    tab.layout
+        .panes(area)
+        .into_iter()
+        .find(|info| info.id == focused)
+        .map(|info| protocol::ClientShellZoomSides {
+            left: info.rect.x > area.x,
+            right: info.rect.right() < area.right(),
+            up: info.rect.y > area.y,
+            down: info.rect.bottom() < area.bottom(),
+        })
+        .unwrap_or_default()
+}
