+    #[test]
+    fn zoom_sides_point_at_the_hidden_panes() {
+        use ratatui::layout::Direction::{Horizontal, Vertical};
+        let sides = |left, right, up, down| protocol::ClientShellZoomSides {
+            left,
+            right,
+            up,
+            down,
+        };
+        let mut tab = crate::workspace::Workspace::test_new("zoom").tabs.remove(0);
+        let first = tab.layout.focused();
+        assert_eq!(zoom_sides(&tab), sides(false, false, false, false));
+        tab.zoomed = true;
+
+        let second = tab.layout.split_pane(first, Horizontal, 0.5).unwrap();
+        assert_eq!(zoom_sides(&tab), sides(false, true, false, false));
+
+        let third = tab.layout.split_pane(second, Horizontal, 0.5).unwrap();
+        tab.layout.focus_pane(third);
+        assert_eq!(zoom_sides(&tab), sides(true, false, false, false));
+        tab.layout.focus_pane(second);
+        assert_eq!(zoom_sides(&tab), sides(true, true, false, false));
+
+        let below = tab.layout.split_pane(first, Vertical, 0.5).unwrap();
+        tab.layout.focus_pane(first);
+        assert_eq!(zoom_sides(&tab), sides(false, true, false, true));
+        tab.layout.focus_pane(below);
+        assert_eq!(zoom_sides(&tab), sides(false, true, true, false));
+
+        tab.zoomed = false;
+        assert_eq!(zoom_sides(&tab), sides(false, false, false, false));
+    }
