{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skillOverrides": {
    "claude-api": "name-only",
    "cleanup": "user-invocable-only",
    "cleanup-repo": "user-invocable-only",
    "dataviz": "off",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "loop": "user-invocable-only",
    "save-session": "user-invocable-only",
    "schedule": "user-invocable-only",
    "security-review": "user-invocable-only",
    "update-notes": "user-invocable-only",
    "update-now": "user-invocable-only"
  },
  "bashEditDiffEnabled": true,
  "extraKnownMarketplaces": {
    "runpod": {
      "source": {
        "source": "github",
        "repo": "runpod/runpod-plugins-official"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "prefersReducedMotion": true,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "voiceEnabled": true,
  "autoDream": {
    "enabled": true,
    "intervalHours": 24
  },
  "autoMemory": {
    "enabled": true,
    "scope": "user"
  }
}
