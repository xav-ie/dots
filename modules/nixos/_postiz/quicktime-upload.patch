+
+// QuickTime (.mov, what phones record) is stored as MP4: Postiz decides
+// whether media is a video by finding "mp4" in its path, and browsers that
+// can't open .mov (e.g. on Windows) play MP4. ffmpeg rewraps the streams
+// without re-encoding; it needs a file on disk because phones write the
+// index at the end. If ffmpeg can't remux it, the original bytes are stored.
+async function remuxQuickTimeToStorage(
+  storage: IUploadProvider,
+  sniffed: ReadableStream,
+  maxSize: number
+) {
+  const dir = await mkdtemp(join(tmpdir(), 'remux-'));
+  try {
+    const input = join(dir, 'in.mov');
+    const output = join(dir, 'out.mp4');
+    await pipelineAsync(
+      Readable.fromWeb(sniffed as any),
+      maxSizeStream(maxSize),
+      createWriteStream(input)
+    );
+
+    let source = output;
+    try {
+      // Video and audio only: phones add metadata tracks MP4 rejects
+      await promisify(execFile)('ffmpeg', [
+        '-v', 'error',
+        '-i', input,
+        '-map', '0:v',
+        '-map', '0:a?',
+        '-c', 'copy',
+        '-movflags', '+faststart',
+        output,
+      ]);
+    } catch (err) {
+      console.error('QuickTime remux failed, storing the original:', err);
+      source = input;
+    }
+
+    const uploaded = await storage.uploadStream(
+      createReadStream(source),
+      'video/mp4',
+      'mp4'
+    );
+    return { ...uploaded, ext: 'mp4' };
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+}
