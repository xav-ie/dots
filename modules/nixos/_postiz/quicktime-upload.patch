diff --git a/libraries/nestjs-libraries/src/upload/sniff.upload.ts b/libraries/nestjs-libraries/src/upload/sniff.upload.ts
new file mode 100644
index 00000000..ec59f79a
--- /dev/null
+++ b/libraries/nestjs-libraries/src/upload/sniff.upload.ts
@@ -0,0 +1,52 @@
+import { execFile } from 'child_process';
+import { mkdtemp, readFile, rm, writeFile } from 'fs/promises';
+import { tmpdir } from 'os';
+import { join } from 'path';
+import { promisify } from 'util';
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const { fromBuffer } = require('file-type');
+
+// Sniffs an upload's real type from its bytes. QuickTime (.mov, what phones
+// record) is reported as MP4: it shares MP4's ISO base media layout and the
+// social platforms accept it, while Postiz decides whether media is a video
+// by finding "mp4" in its path, so a .mov path would be posted as an image.
+export const sniffUpload = async (buffer: Buffer | Uint8Array) => {
+  const detected = await fromBuffer(buffer);
+  if (detected?.mime === 'video/quicktime') {
+    return { ext: 'mp4', mime: 'video/mp4' };
+  }
+  return detected;
+};
+
+// Rewraps a QuickTime upload into a real MP4 container without re-encoding,
+// so browsers that can't open .mov (e.g. on Windows) can still play it.
+// Anything else, or a .mov ffmpeg can't remux, is returned unchanged.
+export const remuxQuickTime = async (buffer: Buffer): Promise<Buffer> => {
+  const detected = await fromBuffer(buffer);
+  if (detected?.mime !== 'video/quicktime') {
+    return buffer;
+  }
+
+  const dir = await mkdtemp(join(tmpdir(), 'remux-'));
+  try {
+    const input = join(dir, 'in.mov');
+    const output = join(dir, 'out.mp4');
+    await writeFile(input, buffer);
+    // Video and audio only: phones add metadata tracks the MP4 muxer rejects.
+    await promisify(execFile)('ffmpeg', [
+      '-v', 'error',
+      '-i', input,
+      '-map', '0:v',
+      '-map', '0:a?',
+      '-c', 'copy',
+      '-movflags', '+faststart',
+      output,
+    ]);
+    return await readFile(output);
+  } catch (err) {
+    console.error('QuickTime remux failed, storing the original:', err);
+    return buffer;
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+};
