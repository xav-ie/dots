diff --git a/packages/sdk/src/implementation/tool-search-embeddings.ts b/packages/sdk/src/implementation/tool-search-embeddings.ts
new file mode 100644
index 000000000..6359d53a6
--- /dev/null
+++ b/packages/sdk/src/implementation/tool-search-embeddings.ts
@@ -0,0 +1,204 @@
+/**
+ * Optional similarity ranking for tool search through an OpenAI-compatible embeddings endpoint
+ * (`{ input: string[] }` to `{ model, data: [{ index, embedding }] }`). Tool vectors are kept in
+ * the database and filled in the background, so writing a listing never waits for the endpoint;
+ * a search embeds only its query, and ranks by BM25 alone when that fails or is too slow.
+ */
+import { Clock, Effect, Option, Schema } from "effect";
+import { type HttpClient, HttpClientRequest, HttpClientResponse } from "effect/http";
+import type { BackgroundWork } from "../contracts/declarations.ts";
+import type { ToolSearchStore } from "./tool-search-store.ts";
+
+/** Queries carry the retrieval task; tool texts are embedded as they are. */
+const instruction =
+  "Instruct: Given a user request, retrieve the tool that can fulfill it\nQuery: ";
+const batchSize = 32;
+/** Texts read per fill round; each round's vectors are saved before the next. */
+const fillRound = 256;
+const defaultTimeoutMillis = 1_500;
+/** Similarity alone ranked recorded searches best; words still rank tools without a vector yet. */
+const defaultKeywordWeight = 0;
+const cachedQueries = 256;
+
+/** The endpoint failed; `refused` when it answered that it will not embed this input. */
+class EmbeddingsFailed extends Schema.TaggedError<EmbeddingsFailed>()("EmbeddingsFailed", {
+  refused: Schema.Boolean,
+}) {}
+
+const Embeddings = Schema.Struct({
+  model: Schema.optional(Schema.String),
+  data: Schema.Array(Schema.Struct({ index: Schema.Int, embedding: Schema.Array(Schema.Number) })),
+});
+
+/** A unit vector; components too small for `real` become zero instead of failing to store. */
+const unit = (values: ReadonlyArray<number>) => {
+  const norm = Math.sqrt(values.reduce((sum, value) => sum + value * value, 0)) || 1;
+  return values.map((value) => (Math.abs(value / norm) < 1e-30 ? 0 : value / norm));
+};
+
+export interface QueryVector {
+  readonly model: string;
+  readonly vector: ReadonlyArray<number>;
+}
+
+export const makeToolSearchEmbeddings = (options: {
+  readonly url: string;
+  readonly timeoutMs?: number | undefined;
+  readonly keywordWeight?: number | undefined;
+  readonly httpClient: HttpClient.HttpClient;
+}) => {
+  const queries = new Map<string, QueryVector>();
+  /** When each warning was last logged; each is logged at most once a minute. */
+  const warned = new Map<string, number>();
+  const warn = (message: string) =>
+    Effect.gen(function* () {
+      const now = yield* Clock.currentTimeMillis;
+      if (now - (warned.get(message) ?? Number.NEGATIVE_INFINITY) < 60_000) return;
+      warned.set(message, now);
+      yield* Effect.logWarning(message);
+    });
+  const embed = (input: ReadonlyArray<string>) =>
+    Effect.gen(function* () {
+      const response = yield* options.httpClient
+        .execute(
+          HttpClientRequest.post(options.url).pipe(HttpClientRequest.bodyJsonUnsafe({ input })),
+        )
+        .pipe(Effect.mapError(() => new EmbeddingsFailed({ refused: false })));
+      if (response.status >= 400 && response.status < 500)
+        return yield* new EmbeddingsFailed({ refused: true });
+      const body = yield* HttpClientResponse.filterStatusOk(response).pipe(
+        Effect.flatMap(HttpClientResponse.schemaBodyJson(Embeddings)),
+        Effect.mapError(() => new EmbeddingsFailed({ refused: false })),
+      );
+      const vectors: Array<ReadonlyArray<number> | undefined> = Array.from(input, () => undefined);
+      for (const { index, embedding } of body.data) vectors[index] = unit(embedding);
+      if (body.data.length !== input.length || vectors.includes(undefined))
+        return yield* new EmbeddingsFailed({ refused: false });
+      return {
+        // The model names the vectors, so another model behind the same URL embeds again.
+        model: body.model ?? options.url,
+        vectors: vectors.flatMap((vector) => (vector === undefined ? [] : [vector])),
+      };
+    });
+  let model: string | undefined;
+  /**
+   * Embed the texts of rows without a vector of the current model, a round at a time. When that
+   * or the caller (`changed`) changed which texts rows have, drop vectors no row reads. A batch the endpoint refuses, such as one with a text longer than its
+   * context, is embedded one text at a time, and a text it refuses alone waits for the next fill.
+   * Any other failure ends the fill.
+   */
+  const embedPending = (store: ToolSearchStore, changed: boolean) =>
+    Effect.gen(function* () {
+      model ??= (yield* embed(["model"])).model;
+      let saved = 0;
+      const refused = new Set<string>();
+      const save = (texts: ReadonlyArray<string>) =>
+        Effect.flatMap(embed(texts), (embedded) => {
+          model = embedded.model;
+          return store
+            .saveVectors(
+              embedded.model,
+              texts.map((text, at) => ({ text, embedding: embedded.vectors[at] ?? [] })),
+            )
+            .pipe(Effect.as(texts.length));
+        });
+      for (;;) {
+        const texts = (yield* store.pendingTexts(model, fillRound)).filter(
+          (text) => !refused.has(text),
+        );
+        const batches: Array<ReadonlyArray<string>> = [];
+        for (let start = 0; start < texts.length; start += batchSize)
+          batches.push(texts.slice(start, start + batchSize));
+        const counts = yield* Effect.forEach(
+          batches,
+          (batch) =>
+            save(batch).pipe(
+              Effect.catchIf(
+                (error) => error._tag === "EmbeddingsFailed" && error.refused,
+                () =>
+                  Effect.forEach(batch, (text) =>
+                    save([text]).pipe(
+                      Effect.catchIf(
+                        (error) => error._tag === "EmbeddingsFailed" && error.refused,
+                        () => Effect.sync(() => (refused.add(text), 0)),
+                      ),
+                    ),
+                  ),
+              ),
+            ),
+          { concurrency: 2 },
+        );
+        const round = counts.flat().reduce((sum, count) => sum + count, 0);
+        if (round === 0) break;
+        saved += round;
+      }
+      if (changed || saved > 0) yield* store.pruneVectors(model);
+    });
+  let filling = false;
+  let again = false;
+  let requestedAt = Number.NEGATIVE_INFINITY;
+  return {
+    /** The share of a fused score that comes from BM25 rather than similarity. */
+    keywordWeight: Math.min(1, Math.max(0, options.keywordWeight ?? defaultKeywordWeight)),
+    /** The query's vector, from a small cache or the endpoint within the time budget. */
+    query: (query: string): Effect.Effect<Option.Option<QueryVector>> =>
+      Effect.gen(function* () {
+        const cached = queries.get(query);
+        if (cached !== undefined) {
+          queries.delete(query);
+          queries.set(query, cached);
+          return Option.some(cached);
+        }
+        const embedded = yield* embed([`${instruction}${query}`]).pipe(
+          Effect.timeoutOption(options.timeoutMs ?? defaultTimeoutMillis),
+        );
+        if (Option.isNone(embedded)) {
+          yield* warn("Tool search ranked by words alone: the query embedding timed out");
+          return Option.none();
+        }
+        const vector = embedded.value.vectors[0];
+        if (vector === undefined) return Option.none();
+        const found = { model: embedded.value.model, vector };
+        // A model the fill has not embedded with yet means its vectors are missing.
+        if (model !== undefined && model !== found.model) model = undefined;
+        queries.set(query, found);
+        for (const oldest of queries.keys()) {
+          if (queries.size <= cachedQueries) break;
+          queries.delete(oldest);
+        }
+        return Option.some(found);
+      }).pipe(
+        Effect.catch(() =>
+          warn("Tool search ranked by words alone: the query embedding failed").pipe(
+            Effect.as(Option.none()),
+          ),
+        ),
+      ),
+    embedPending,
+    /**
+     * Run `work` in the background unless a fill is running, which then runs again after it.
+     * `throttled` requests, made by searches, start at most one fill a minute.
+     */
+    fill: <E>(background: BackgroundWork, throttled: boolean, work: Effect.Effect<void, E>) =>
+      Effect.gen(function* () {
+        const now = yield* Clock.currentTimeMillis;
+        if (throttled && now - requestedAt < 60_000) return;
+        requestedAt = now;
+        if (filling) {
+          again = true;
+          return;
+        }
+        filling = true;
+        const run = Effect.gen(function* () {
+          do {
+            again = false;
+            yield* work.pipe(
+              Effect.catch(() => warn("Tool search vectors were not filled; a later fill retries")),
+            );
+          } while (again);
+        }).pipe(Effect.ensuring(Effect.sync(() => (filling = false))));
+        if (!(yield* background(run))) filling = false;
+      }),
+  };
+};
+export type ToolSearchEmbeddings = ReturnType<typeof makeToolSearchEmbeddings>;
