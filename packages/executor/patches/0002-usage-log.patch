diff --git a/apps/local/server/src/implementation/usage-log.ts b/apps/local/server/src/implementation/usage-log.ts
new file mode 100644
index 000000000..bad8f6931
--- /dev/null
+++ b/apps/local/server/src/implementation/usage-log.ts
@@ -0,0 +1,40 @@
+/**
+ * `EXECUTOR_USAGE_LOG=<path>` appends one JSON line per MCP search, describe and tool call to the
+ * file, for evaluating search offline. Each line carries the MCP session and a per-request
+ * execution ID, so a search joins the calls the same session made after it. Lines are written in
+ * order by one fiber; a failed write is dropped and reported at most once a minute.
+ */
+import type { McpUsageEvent } from "@executor-js/mcp";
+import { Clock, Config, DateTime, Effect, FileSystem, Option, Queue } from "effect";
+
+/** The usage sink for one MCP request, or undefined when the log is off. */
+export const localUsageLog = Effect.gen(function* () {
+  const file = yield* Config.String("EXECUTOR_USAGE_LOG").pipe(Config.option);
+  if (Option.isNone(file) || file.value === "") return undefined;
+  const fs = yield* FileSystem.FileSystem;
+  const lines = yield* Queue.unbounded<string>();
+  let reportedAt = Number.NEGATIVE_INFINITY;
+  yield* Effect.forkScoped(
+    Effect.forever(
+      Queue.takeAll(lines).pipe(
+        Effect.flatMap((batch) => fs.writeFileString(file.value, batch.join(""), { flag: "a" })),
+        Effect.catch((error) =>
+          Effect.gen(function* () {
+            const now = yield* Clock.currentTimeMillis;
+            if (now - reportedAt < 60_000) return;
+            reportedAt = now;
+            yield* Effect.logWarning(`Usage log write to ${file.value} failed`, error);
+          }),
+        ),
+      ),
+    ),
+  );
+  return (request: { readonly sessionId: string | undefined; readonly executionId: string }) =>
+    (event: McpUsageEvent) =>
+      Effect.flatMap(DateTime.now, (now) =>
+        Queue.offer(
+          lines,
+          `${JSON.stringify({ ts: DateTime.formatIso(now), ...request, ...event })}\n`,
+        ),
+      ).pipe(Effect.asVoid);
+});
