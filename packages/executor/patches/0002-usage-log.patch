diff --git a/packages/mcp/src/implementation/usage.ts b/packages/mcp/src/implementation/usage.ts
new file mode 100644
index 000000000..69d069ecf
--- /dev/null
+++ b/packages/mcp/src/implementation/usage.ts
@@ -0,0 +1,69 @@
+/**
+ * An optional record of what agents search for and which tools they call afterwards, so search can
+ * be evaluated offline against real use. A host provides `McpUsage` to receive events; without it
+ * nothing is recorded. Events hold canonical paths, outcomes and timing, never arguments or results.
+ */
+import { Cause, Clock, Context, Effect, Exit, Option, Predicate } from "effect";
+
+export type McpUsageEvent =
+  | {
+      readonly type: "search";
+      readonly query: string;
+      readonly namespace: string | undefined;
+      readonly limit: number | undefined;
+      readonly offset: number | undefined;
+      readonly ok: boolean;
+      /** The first results, best first. */
+      readonly results: ReadonlyArray<{ readonly path: string }>;
+    }
+  | { readonly type: "describe"; readonly paths: ReadonlyArray<string>; readonly ok: boolean }
+  | {
+      readonly type: "call";
+      readonly path: string;
+      readonly ok: boolean;
+      readonly durationMs: number;
+      readonly errorCode?: string;
+    };
+
+/** Receives the usage events of the current request, when the host records them. */
+export const McpUsage = Context.Reference<
+  ((event: McpUsageEvent) => Effect.Effect<void>) | undefined
+>("@executor-js/mcp/McpUsage", { defaultValue: () => undefined });
+
+/** Results a search event keeps. */
+export const usageResults = 10;
+
+/** Run an operation unchanged, and record its outcome when the host records usage. */
+export const recordUsage =
+  <A, E>(event: (exit: Exit.Exit<A, E>, durationMs: number) => McpUsageEvent) =>
+  <R>(effect: Effect.Effect<A, E, R>): Effect.Effect<A, E, R> =>
+    Effect.flatMap(McpUsage, (record) =>
+      record === undefined
+        ? effect
+        : Effect.flatMap(Clock.currentTimeMillis, (started) =>
+            effect.pipe(
+              Effect.onExit((exit) =>
+                Effect.flatMap(Clock.currentTimeMillis, (ended) =>
+                  record(event(exit, ended - started)),
+                ),
+              ),
+            ),
+          ),
+    );
+
+/**
+ * Why a call failed, as its event's error code: the failure's tag, or `ToolResultError` for an
+ * MCP result with `isError: true`, which a call returns as its value. Undefined when it succeeded.
+ */
+export const usageErrorCode = (exit: Exit.Exit<unknown, unknown>) => {
+  if (Exit.isSuccess(exit))
+    return Predicate.hasProperty(exit.value, "isError") && exit.value.isError === true
+      ? "ToolResultError"
+      : undefined;
+  if (Cause.hasInterruptsOnly(exit.cause)) return "Interrupted";
+  const error = Option.getOrUndefined(Cause.findErrorOption(exit.cause));
+  if (error === undefined) return "Defect";
+  return Predicate.hasProperty(error, "_tag") && typeof error._tag === "string"
+    ? error._tag
+    : "Error";
+};
