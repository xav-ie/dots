+    /// The sender's photo, from the backend's synced contact avatars first
+    /// (what the web UI shows), then the Mac's Contacts.
+    private func avatarAttachment(source: String, name: String, number: String?) async -> UNNotificationAttachment? {
+        let numbers = Self.nonEmpty(number).map { [$0] } ?? []
+        var data: Data?
+        if let number = numbers.first {
+            let url = apiURL(
+                pathComponents: ["api", "avatar"],
+                queryItems: [
+                    URLQueryItem(name: "source", value: source),
+                    URLQueryItem(name: "phone", value: number),
+                ]
+            )
+            if let (body, response) = try? await URLSession.shared.data(from: url),
+               (response as? HTTPURLResponse)?.statusCode == 200,
+               !body.isEmpty {
+                data = body
+            }
+        }
+        if data == nil {
+            data = await contacts.avatarData(name: name, numbers: numbers)
+        }
+        guard let data else { return nil }
+
+        // UNNotificationAttachment infers the type from the extension and moves
+        // the file into the notification store.
+        let ext: String
+        if data.starts(with: [0x89, 0x50, 0x4E, 0x47]) {
+            ext = "png"
+        } else if data.starts(with: [0x47, 0x49, 0x46, 0x38]) {
+            ext = "gif"
+        } else {
+            ext = "jpg"
+        }
+        let file = FileManager.default.temporaryDirectory
+            .appendingPathComponent("openmessage-avatar-\(UUID().uuidString).\(ext)")
+        do {
+            try data.write(to: file)
+            return try UNNotificationAttachment(identifier: "avatar", url: file)
+        } catch {
+            logger.debug("Notification avatar error: \(error)")
+            try? FileManager.default.removeItem(at: file)
+            return nil
+        }
+    }
+
+    private static func nonEmpty(_ value: String?) -> String? {
+        guard let value = value?.trimmingCharacters(in: .whitespacesAndNewlines), !value.isEmpty else {
+            return nil
+        }
+        return value
+    }
