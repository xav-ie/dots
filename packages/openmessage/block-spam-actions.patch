diff --git a/internal/web/block_test.go b/internal/web/block_test.go
new file mode 100644
index 0000000..0fcde13
--- /dev/null
+++ b/internal/web/block_test.go
@@ -0,0 +1,141 @@
+package web
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+
+	"github.com/maxghenis/openmessage/internal/app"
+	"github.com/maxghenis/openmessage/internal/db"
+	"github.com/maxghenis/openmessage/internal/storage/sqlite"
+	"github.com/maxghenis/openmessage/internal/v2read"
+)
+
+func blockedTestHandler(t *testing.T, setBlocked func(remoteID string, block, reportSpam bool) error) http.Handler {
+	t.Helper()
+	v2, err := sqlite.Open(filepath.Join(t.TempDir(), "v2.sqlite3"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = v2.Close() })
+	nowMS := time.Now().UnixMilli()
+	for id, bridge := range map[string]string{"google-primary": "google_messages", "signal-primary": "signal"} {
+		if err := v2.UpsertAccount(sqlite.Account{
+			AccountID:   id,
+			BridgeKey:   bridge,
+			DisplayName: bridge,
+			Mode:        sqlite.AccountModeLive,
+			Enabled:     true,
+			ConfigJSON:  "{}",
+			CreatedAtMS: nowMS,
+			UpdatedAtMS: nowMS,
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for id, account := range map[string]string{"conv-a": "google-primary", "conv-sig": "signal-primary"} {
+		if err := v2.UpsertConversation(sqlite.Conversation{
+			ConversationID:       id,
+			AccountID:            account,
+			RemoteConversationID: "remote-" + id,
+			Kind:                 sqlite.ConversationKindDirect,
+			NotificationMode:     sqlite.NotificationModeAll,
+			MetadataJSON:         "{}",
+			CreatedAtMS:          nowMS,
+			UpdatedAtMS:          nowMS,
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	legacy, err := db.New(":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = legacy.Close() })
+	return APIHandlerWithOptions(legacy, nil, zerolog.Nop(), nil, APIOptions{
+		Reads:            v2read.New(v2),
+		V2Primary:        true,
+		SetGoogleBlocked: setBlocked,
+	})
+}
+
+func TestConversationBlockedAction(t *testing.T) {
+	type blockCall struct {
+		remoteID          string
+		block, reportSpam bool
+	}
+	calls := []blockCall{}
+	reject := false
+	handler := blockedTestHandler(t, func(remoteID string, block, reportSpam bool) error {
+		calls = append(calls, blockCall{remoteID, block, reportSpam})
+		if reject {
+			return app.ErrPhoneRejectedUpdate
+		}
+		return nil
+	})
+	do := func(method, path, body string) *httptest.ResponseRecorder {
+		t.Helper()
+		req := httptest.NewRequest(method, "http://127.0.0.1"+path, strings.NewReader(body))
+		req.Header.Set("Origin", "http://127.0.0.1")
+		req.Header.Set("Content-Type", "application/json")
+		resp := httptest.NewRecorder()
+		handler.ServeHTTP(resp, req)
+		return resp
+	}
+
+	resp := do(http.MethodPost, "/api/conversations/conv-a/blocked", `{"blocked": true, "report_spam": true}`)
+	if resp.Code != http.StatusOK {
+		t.Fatalf("block: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+	var convo db.Conversation
+	if err := json.Unmarshal(resp.Body.Bytes(), &convo); err != nil {
+		t.Fatal(err)
+	}
+	if convo.ConversationID != "conv-a" {
+		t.Fatalf("block answered %+v, want conv-a", convo)
+	}
+	resp = do(http.MethodPost, "/api/conversations/conv-a/blocked", `{"blocked": false}`)
+	if resp.Code != http.StatusOK {
+		t.Fatalf("unblock: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+	want := []blockCall{{"remote-conv-a", true, true}, {"remote-conv-a", false, false}}
+	if len(calls) != len(want) {
+		t.Fatalf("phone calls = %+v, want %+v", calls, want)
+	}
+	for i, call := range calls {
+		if call != want[i] {
+			t.Errorf("phone call %d = %+v, want %+v", i, call, want[i])
+		}
+	}
+
+	if resp := do(http.MethodPost, "/api/conversations/conv-a/blocked", `{}`); resp.Code != http.StatusBadRequest {
+		t.Errorf("missing flag: status = %d, want 400", resp.Code)
+	}
+	if resp := do(http.MethodPost, "/api/conversations/conv-sig/blocked", `{"blocked": true}`); resp.Code != http.StatusBadRequest {
+		t.Errorf("non-Google conversation: status = %d, want 400", resp.Code)
+	}
+	if resp := do(http.MethodPost, "/api/conversations/missing/blocked", `{"blocked": true}`); resp.Code != http.StatusNotFound {
+		t.Errorf("unknown conversation: status = %d, want 404", resp.Code)
+	}
+	reject = true
+	if resp := do(http.MethodPost, "/api/conversations/conv-a/blocked", `{"blocked": true}`); resp.Code != http.StatusBadGateway {
+		t.Errorf("phone rejection: status = %d, want 502", resp.Code)
+	}
+
+	if handler := blockedTestHandler(t, nil); func() bool {
+		req := httptest.NewRequest(http.MethodPost, "http://127.0.0.1/api/conversations/conv-a/blocked", strings.NewReader(`{"blocked": true}`))
+		req.Header.Set("Origin", "http://127.0.0.1")
+		req.Header.Set("Content-Type", "application/json")
+		resp := httptest.NewRecorder()
+		handler.ServeHTTP(resp, req)
+		return resp.Code != http.StatusServiceUnavailable
+	}() {
+		t.Error("without a bridge the action should answer 503")
+	}
+}
