+++ b/internal/app/block_sync.go
@@ -0,0 +1,49 @@
+package app
+
+import (
+	"fmt"
+	"strings"
+
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+)
+
+// SetGoogleConversationBlocked blocks a Google conversation on the phone, or
+// unblocks it with block false. Google Messages has no report-only verb —
+// spam reporting rides on the block as one phone action, so reportSpam asks
+// for "block & report spam" instead of a plain block. The phone owns Spam &
+// blocked: its live status event files the thread into or out of the folder.
+func (a *App) SetGoogleConversationBlocked(remoteID string, block, reportSpam bool) error {
+	remoteID = strings.TrimSpace(remoteID)
+	if remoteID == "" {
+		return fmt.Errorf("conversation id is required")
+	}
+	gm := a.getGMClient()
+	if gm == nil {
+		return fmt.Errorf("client not connected")
+	}
+	updater, ok := gm.(gmConversationUpdater)
+	if !ok {
+		return fmt.Errorf("conversation updates are unavailable")
+	}
+	var action gmproto.ConversationActionStatus
+	switch {
+	case block && reportSpam:
+		action = gmproto.ConversationActionStatus_BLOCK_AND_REPORT
+	case block:
+		action = gmproto.ConversationActionStatus_BLOCK
+	default:
+		action = gmproto.ConversationActionStatus_UNBLOCK
+	}
+	resp, err := updater.UpdateConversation(&gmproto.UpdateConversationRequest{
+		Action:         action,
+		ConversationID: remoteID,
+	})
+	if err != nil {
+		a.HandleGoogleAuthExpiredError(err)
+		return fmt.Errorf("update conversation: %w", err)
+	}
+	if !resp.GetSuccess() {
+		return ErrPhoneRejectedUpdate
+	}
+	return nil
+}
