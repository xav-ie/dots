@@ -0,0 +1,54 @@
+package app
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/rs/zerolog"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+)
+
+func TestSetGoogleConversationBlocked(t *testing.T) {
+	gm := &updatingGMClient{mockGMClient: &mockGMClient{}, resp: &gmproto.UpdateConversationResponse{Success: true}}
+	a := &App{Logger: zerolog.Nop(), gmClient: gm}
+
+	cases := []struct {
+		block, reportSpam bool
+		want              gmproto.ConversationActionStatus
+	}{
+		{true, false, gmproto.ConversationActionStatus_BLOCK},
+		{true, true, gmproto.ConversationActionStatus_BLOCK_AND_REPORT},
+		{false, false, gmproto.ConversationActionStatus_UNBLOCK},
+	}
+	for _, tc := range cases {
+		if err := a.SetGoogleConversationBlocked("1189", tc.block, tc.reportSpam); err != nil {
+			t.Fatalf("SetGoogleConversationBlocked(1189, %v, %v): %v", tc.block, tc.reportSpam, err)
+		}
+	}
+	if len(gm.requests) != len(cases) {
+		t.Fatalf("sent %d updates, want %d", len(gm.requests), len(cases))
+	}
+	for i, req := range gm.requests {
+		if req.GetConversationID() != "1189" || req.GetAction() != cases[i].want {
+			t.Errorf("update %d = action %s for %q, want action %s", i, req.GetAction(), req.GetConversationID(), cases[i].want)
+		}
+	}
+
+	gm.resp = &gmproto.UpdateConversationResponse{}
+	if err := a.SetGoogleConversationBlocked("1189", true, false); !errors.Is(err, ErrPhoneRejectedUpdate) {
+		t.Errorf("unsuccessful answer = %v, want ErrPhoneRejectedUpdate", err)
+	}
+	failure := errors.New("timed out")
+	gm.resp, gm.err = nil, failure
+	if err := a.SetGoogleConversationBlocked("1189", true, false); !errors.Is(err, failure) {
+		t.Errorf("failed call = %v, want it wrapped", err)
+	}
+
+	plain := &App{Logger: zerolog.Nop(), gmClient: &mockGMClient{}}
+	if err := plain.SetGoogleConversationBlocked("1189", true, false); err == nil {
+		t.Error("a client without conversation updates reported success")
+	}
+	if err := a.SetGoogleConversationBlocked("  ", true, false); err == nil {
+		t.Error("an empty conversation id reported success")
+	}
+}
