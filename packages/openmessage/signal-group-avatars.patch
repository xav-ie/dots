+
+// RemoteConversationID returns the platform's own id for a conversation
+// ("signal-group:<b64>", a WhatsApp JID, a Google thread id), which the DTOs
+// don't carry. The id may be a v2 conversation ID or a legacy remote ID; an
+// unknown one returns sql.ErrNoRows like GetConversation.
+func (s *Source) RemoteConversationID(id string) (string, error) {
+	if err := s.ready(); err != nil {
+		return "", err
+	}
+	conversation, err := s.store.GetConversation(s.resolveConversationID(id))
+	if errors.Is(err, sqlite.ErrNotFound) {
+		return "", sql.ErrNoRows
+	}
+	if err != nil {
+		return "", err
+	}
+	return conversation.RemoteConversationID, nil
+}
