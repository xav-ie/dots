new file mode 100644
index 0000000..33e9331
--- /dev/null
+++ b/internal/signallive/group_avatar.go
@@ -0,0 +1,32 @@
+package signallive
+
+import (
+	"encoding/base64"
+	"fmt"
+	"path/filepath"
+	"strings"
+)
+
+// GroupAvatarPath returns where signal-cli keeps the photo of the group a
+// "signal-group:<base64 group id>" conversation names:
+// <configDir>/avatars/group-<standard base64 group id with "/" as "_">
+// (signal-cli keeps "+" and the padding). signal-cli writes
+// the file only for groups that have a photo.
+//
+// The file name is re-encoded from the decoded id, never copied from the
+// input, and an id that doesn't round-trip through standard base64 is
+// rejected, so no conversation id can name a file outside the avatars dir.
+func GroupAvatarPath(configDir, conversationID string) (string, error) {
+	groupID, isGroup, err := parseConversationTarget(conversationID)
+	if err != nil {
+		return "", err
+	}
+	if !isGroup {
+		return "", fmt.Errorf("not a Signal group conversation: %q", conversationID)
+	}
+	raw, err := base64.StdEncoding.DecodeString(groupID)
+	if err != nil || base64.StdEncoding.EncodeToString(raw) != groupID {
+		return "", fmt.Errorf("invalid Signal group id %q", groupID)
+	}
+	return filepath.Join(configDir, "avatars", "group-"+strings.ReplaceAll(base64.StdEncoding.EncodeToString(raw), "/", "_")), nil
+}
