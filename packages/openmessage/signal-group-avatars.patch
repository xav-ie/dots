@@ -0,0 +1,153 @@
+package web
+
+import (
+	"bytes"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+
+	"github.com/maxghenis/openmessage/internal/db"
+	"github.com/maxghenis/openmessage/internal/storage/sqlite"
+	"github.com/maxghenis/openmessage/internal/v2keys"
+	"github.com/maxghenis/openmessage/internal/v2read"
+)
+
+const (
+	signalAvatarGroupID      = "8PE+/vv7+/v7+/v7+/v7+/v7+/v7+/v7+/v7+/v7xSI="
+	signalAvatarGroupFile    = "group-8PE+_vv7+_v7+_v7+_v7+_v7+_v7+_v7+_v7+_v7xSI="
+	signalAvatarConversation = "signal-group:" + signalAvatarGroupID
+)
+
+var signalAvatarPNG = []byte("\x89PNG\r\n\x1a\n\x00\x00\x00\rIHDR")
+
+func writeSignalGroupAvatar(t *testing.T, configDir string) {
+	t.Helper()
+	dir := filepath.Join(configDir, "avatars")
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, signalAvatarGroupFile), signalAvatarPNG, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func getSignalGroupAvatar(t *testing.T, handler http.Handler, conversationID, ifNoneMatch string) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodGet, "http://127.0.0.1/api/signal/group-avatar?conversation_id="+url.QueryEscape(conversationID), nil)
+	if ifNoneMatch != "" {
+		req.Header.Set("If-None-Match", ifNoneMatch)
+	}
+	recorder := httptest.NewRecorder()
+	handler.ServeHTTP(recorder, req)
+	return recorder
+}
+
+func TestSignalGroupAvatarRouteServesLegacyGroupPhoto(t *testing.T) {
+	configDir := t.TempDir()
+	ts := newTestServerWithOptions(t, APIOptions{SignalConfigDir: configDir})
+	for _, convo := range []*db.Conversation{
+		{ConversationID: signalAvatarConversation, Name: "Climbing", IsGroup: true, SourcePlatform: "signal"},
+		{ConversationID: "signal:+15551234567", Name: "Alice", SourcePlatform: "signal"},
+	} {
+		if err := ts.store.UpsertConversation(convo); err != nil {
+			t.Fatal(err)
+		}
+	}
+	handler := ts.server.Config.Handler
+
+	if got := getSignalGroupAvatar(t, handler, signalAvatarConversation, ""); got.Code != http.StatusNotFound {
+		t.Fatalf("group without a photo file: status = %d, want 404", got.Code)
+	}
+	writeSignalGroupAvatar(t, configDir)
+
+	resp := getSignalGroupAvatar(t, handler, signalAvatarConversation, "")
+	if resp.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200; body=%s", resp.Code, resp.Body.String())
+	}
+	if got := resp.Header().Get("Content-Type"); got != "image/png" {
+		t.Fatalf("content-type = %q, want image/png", got)
+	}
+	if !bytes.Equal(resp.Body.Bytes(), signalAvatarPNG) {
+		t.Fatalf("body = %q, want the avatar file", resp.Body.Bytes())
+	}
+	etag := resp.Header().Get("ETag")
+	if etag == "" {
+		t.Fatal("missing ETag")
+	}
+	if got := getSignalGroupAvatar(t, handler, signalAvatarConversation, etag); got.Code != http.StatusNotModified {
+		t.Fatalf("If-None-Match: status = %d, want 304", got.Code)
+	}
+
+	for _, conversationID := range []string{"signal:+15551234567", "signal-group:unknown", "missing"} {
+		if got := getSignalGroupAvatar(t, handler, conversationID, ""); got.Code != http.StatusNotFound {
+			t.Errorf("%q: status = %d, want 404", conversationID, got.Code)
+		}
+	}
+}
+
+func TestSignalGroupAvatarRouteResolvesV2ConversationIDs(t *testing.T) {
+	v2, err := sqlite.Open(filepath.Join(t.TempDir(), "v2.sqlite3"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = v2.Close() })
+	nowMS := time.Now().UnixMilli()
+	if err := v2.UpsertAccount(sqlite.Account{
+		AccountID:   "signal-primary",
+		BridgeKey:   "signal_cli",
+		DisplayName: "Signal",
+		Mode:        sqlite.AccountModeLive,
+		Enabled:     true,
+		ConfigJSON:  "{}",
+		CreatedAtMS: nowMS,
+		UpdatedAtMS: nowMS,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	conversationID := v2keys.DeriveID("conversation", "signal-primary", signalAvatarConversation)
+	if err := v2.UpsertConversation(sqlite.Conversation{
+		ConversationID:       conversationID,
+		AccountID:            "signal-primary",
+		RemoteConversationID: signalAvatarConversation,
+		Kind:                 sqlite.ConversationKindGroup,
+		Title:                "Climbing",
+		NotificationMode:     sqlite.NotificationModeAll,
+		MetadataJSON:         "{}",
+		CreatedAtMS:          nowMS,
+		UpdatedAtMS:          nowMS,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	legacy, err := db.New(":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = legacy.Close() })
+	configDir := t.TempDir()
+	writeSignalGroupAvatar(t, configDir)
+	handler := APIHandlerWithOptions(legacy, nil, zerolog.Nop(), nil, APIOptions{
+		Reads:           v2read.New(v2),
+		V2Primary:       true,
+		SignalConfigDir: configDir,
+	})
+
+	// The v2 hash the list serves, and the legacy key old references hold.
+	for _, id := range []string{conversationID, signalAvatarConversation} {
+		resp := getSignalGroupAvatar(t, handler, id, "")
+		if resp.Code != http.StatusOK {
+			t.Fatalf("%q: status = %d, want 200; body=%s", id, resp.Code, resp.Body.String())
+		}
+		if !bytes.Equal(resp.Body.Bytes(), signalAvatarPNG) {
+			t.Fatalf("%q: body = %q, want the avatar file", id, resp.Body.Bytes())
+		}
+	}
+	if got := getSignalGroupAvatar(t, handler, v2keys.DeriveID("conversation", "signal-primary", "signal-group:other"), ""); got.Code != http.StatusNotFound {
+		t.Fatalf("unknown v2 id: status = %d, want 404", got.Code)
+	}
+}
