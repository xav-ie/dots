+      .then(async (resp) => {
+        if (resp.status === 404) {
+          cacheSetBounded(signalGroupAvatarCache, normalizedID, null, SIGNAL_GROUP_AVATAR_CACHE_LIMIT);
+          return null;
+        }
+        if (!resp.ok) {
+          throw new Error(`signal group avatar ${resp.status}`);
+        }
+        const blob = await resp.blob();
+        if (!blob || blob.size === 0) {
+          cacheSetBounded(signalGroupAvatarCache, normalizedID, null, SIGNAL_GROUP_AVATAR_CACHE_LIMIT);
+          return null;
