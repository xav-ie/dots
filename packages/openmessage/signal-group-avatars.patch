+package signallive_test
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/maxghenis/openmessage/internal/signallive"
+)
+
+func TestGroupAvatarPathUsesPaddedBase64URL(t *testing.T) {
+	// 32 bytes whose standard encoding carries '+', '/' and one '=' of padding.
+	const groupID = "8PE+/vv7+/v7+/v7+/v7+/v7+/v7+/v7+/v7+/v7xSI="
+	got, err := signallive.GroupAvatarPath("/data/signal-cli", "signal-group:"+groupID)
+	if err != nil {
+		t.Fatalf("GroupAvatarPath: %v", err)
+	}
+	want := filepath.Join("/data/signal-cli", "avatars", "group-8PE+_vv7+_v7+_v7+_v7+_v7+_v7+_v7+_v7+_v7xSI=")
+	if got != want {
+		t.Fatalf("GroupAvatarPath = %q, want %q", got, want)
+	}
+}
+
+func TestGroupAvatarPathRejectsNonGroupsAndIDsThatDoNotRoundTrip(t *testing.T) {
+	for _, conversationID := range []string{
+		"",
+		"signal:+15551234567",
+		"signal-group:",
+		"signal-group:../../etc/passwd",
+		"signal-group:8PE-_vv7-_v7-_v7-_v7-_v7-_v7-_v7-_v7-_v7xSI=",
+		"signal-group:8PE+/vv7+/v7+/v7+/v7+/v7+/v7+/v7+/v7+/v7xSI",
+		"signal-group:8PE+/vv7+/v7+/v7+/v7+/v7+/v7+/v7+/v7+/v7xSJ=",
+		"whatsapp:120363000000000000@g.us",
+	} {
+		if path, err := signallive.GroupAvatarPath("/data/signal-cli", conversationID); err == nil {
+			t.Errorf("GroupAvatarPath(%q) = %q, want an error", conversationID, path)
+		}
+	}
+}
