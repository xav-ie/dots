--- a/e2e/ui.spec.js
+++ b/e2e/ui.spec.js
@@ -204,6 +204,40 @@ test('shows sender labels only in group conversations', async ({ page }) => {
   await expect(page.locator('#messages-area .msg-sender').filter({ hasText: 'David Kim' }).first()).toBeVisible();
 });
 
+test('shows one avatar-and-name header per consecutive sender run', async ({ page, request }) => {
+  await openConversation(page, 'Weekend Hiking Group');
+  const now = Date.now();
+  await request.post('/_e2e/messages', {
+    data: {
+      body: 'First of a consecutive run',
+      conversation_id: 'conv3',
+      sender_name: 'Emily Park',
+      sender_number: '+13105553456',
+      timestamp_ms: now,
+    },
+  });
+  await request.post('/_e2e/messages', {
+    data: {
+      body: 'Second of the same run',
+      conversation_id: 'conv3',
+      sender_name: 'Emily Park',
+      sender_number: '+13105553456',
+      timestamp_ms: now + 1000,
+    },
+  });
+
+  // First message of the run: avatar and name share the header line.
+  const firstRow = page.locator('#messages-area .msg-row').filter({ hasText: 'First of a consecutive run' });
+  await expect(firstRow.locator('.msg-sender')).toHaveText('Emily Park');
+  await expect(firstRow.locator('.msg-avatar:not(.avatar-hidden)')).toBeVisible();
+
+  // Consecutive message from the same sender: no repeated name, avatar kept
+  // only as a hidden spacer so the bubble stays aligned under the header.
+  const secondRow = page.locator('#messages-area .msg-row').filter({ hasText: 'Second of the same run' });
+  await expect(secondRow.locator('.msg-sender')).toHaveCount(0);
+  await expect(secondRow.locator('.msg-avatar.avatar-hidden')).toHaveCount(1);
+});
+
