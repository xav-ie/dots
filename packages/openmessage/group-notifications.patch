+    /// A group's own photo: Signal's from signal-cli, WhatsApp's from the
+    /// bridge. Google Messages exposes none for groups.
+    private func groupAvatarData(conversationID: String, source: String) async -> Data? {
+        let path: [String]
+        switch source {
+        case "signal":
+            path = ["api", "signal", "group-avatar"]
+        case "whatsapp":
+            path = ["api", "whatsapp", "avatar"]
+        default:
+            return nil
+        }
+        let url = apiURL(pathComponents: path, queryItems: [URLQueryItem(name: "conversation_id", value: conversationID)])
+        guard let (body, response) = try? await URLSession.shared.data(from: url),
+              (response as? HTTPURLResponse)?.statusCode == 200,
+              !body.isEmpty else {
+            return nil
+        }
+        return body
+    }
