+package v2read
+
+import (
+	"database/sql"
+	"errors"
+
+	"github.com/maxghenis/openmessage/internal/storage/sqlite"
+)
+
+// MoveConversationToTab is the v2 write behind the web UI's tab moves: v2
+// reads never see the legacy store's tab column. The id may be a v2
+// conversation ID or a legacy remote ID. Tab definitions live in the legacy
+// store, so the caller validates custom tab ids there first.
+func (s *Source) MoveConversationToTab(id, tab string) error {
+	if err := s.ready(); err != nil {
+		return err
+	}
+	err := s.store.SetConversationTab(s.resolveConversationID(id), tab, s.now().UnixMilli())
+	if errors.Is(err, sqlite.ErrNotFound) {
+		return sql.ErrNoRows
+	}
+	return err
+}
+
+// ClearTab returns the conversations filed under a deleted custom tab to
+// Recent.
+func (s *Source) ClearTab(tab string) error {
+	if err := s.ready(); err != nil {
+		return err
+	}
+	return s.store.ClearConversationTab(tab, s.now().UnixMilli())
+}
diff --git a/internal/v2read/tabs_test.go b/internal/v2read/tabs_test.go
new file mode 100644
index 0000000..5de0e0b
--- /dev/null
+++ b/internal/v2read/tabs_test.go
@@ -0,0 +1,120 @@
+package v2read
+
+import (
+	"database/sql"
+	"errors"
+	"testing"
+
+	"github.com/maxghenis/openmessage/internal/db"
+	"github.com/maxghenis/openmessage/internal/storage/sqlite"
+)
+
+func TestMoveConversationToTab(t *testing.T) {
+	store, _, source := openSourceTestStore(t)
+	seedSourceAccount(t, store, "google-account", "google_messages")
+	seedSourceConversation(t, store, sqlite.Conversation{
+		ConversationID:       "conversation-a",
+		AccountID:            "google-account",
+		RemoteConversationID: "remote-a",
+		Kind:                 sqlite.ConversationKindDirect,
+		NotificationMode:     sqlite.NotificationModeAll,
+		MetadataJSON:         `{"other":1}`,
+	})
+	seedSourceConversation(t, store, sqlite.Conversation{
+		ConversationID:       "conversation-spam",
+		AccountID:            "google-account",
+		RemoteConversationID: "remote-spam",
+		Kind:                 sqlite.ConversationKindDirect,
+		NotificationMode:     sqlite.NotificationModeAll,
+		MetadataJSON:         `{"folder":"spam"}`,
+	})
+
+	tabOf := func(id string) string {
+		t.Helper()
+		conversation, err := source.GetConversation(id)
+		if err != nil {
+			t.Fatalf("GetConversation(%q): %v", id, err)
+		}
+		return conversation.Tab
+	}
+	move := func(id, tab string) {
+		t.Helper()
+		if err := source.MoveConversationToTab(id, tab); err != nil {
+			t.Fatalf("MoveConversationToTab(%q, %q): %v", id, tab, err)
+		}
+	}
+
+	if got := tabOf("conversation-a"); got != db.TabInbox {
+		t.Fatalf("initial tab = %q, want Recent", got)
+	}
+	move("conversation-a", db.TabArchive)
+	if got := tabOf("conversation-a"); got != db.TabArchive {
+		t.Fatalf("archived tab = %q, want %q", got, db.TabArchive)
+	}
+	archived, err := store.GetConversation("conversation-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if archived.ArchivedAtMS == nil {
+		t.Fatal("archive did not stamp archived_at_ms")
+	}
+
+	// Ingest rewrites the row it read (the read-modify-write in the ingest
+	// worker), which must keep the archive.
+	archived.Title = "Renamed"
+	archived.UpdatedAtMS++
+	if err := store.UpsertConversation(archived); err != nil {
+		t.Fatal(err)
+	}
+	if got := tabOf("conversation-a"); got != db.TabArchive {
+		t.Fatalf("tab after upsert = %q, want %q", got, db.TabArchive)
+	}
+
+	move("conversation-a", "custom-1")
+	if got := tabOf("conversation-a"); got != "custom-1" {
+		t.Fatalf("custom tab = %q, want custom-1", got)
+	}
+	moved, err := store.GetConversation("conversation-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if moved.ArchivedAtMS != nil {
+		t.Fatal("moving to a custom tab kept the archive stamp")
+	}
+	if sqlite.ConversationFolder(moved.MetadataJSON) != "" || sqlite.ConversationTab(moved.MetadataJSON) != "custom-1" {
+		t.Fatalf("metadata = %s", moved.MetadataJSON)
+	}
+
+	if err := source.ClearTab("custom-1"); err != nil {
+		t.Fatalf("ClearTab(): %v", err)
+	}
+	if got := tabOf("conversation-a"); got != db.TabInbox {
+		t.Fatalf("tab after deleting custom-1 = %q, want Recent", got)
+	}
+
+	move("conversation-a", db.TabArchive)
+	move("conversation-a", db.TabInbox)
+	if got := tabOf("conversation-a"); got != db.TabInbox {
+		t.Fatalf("unarchived tab = %q, want Recent", got)
+	}
+	cleared, err := store.GetConversation("conversation-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cleared.ArchivedAtMS != nil {
+		t.Fatal("unarchive kept archived_at_ms")
+	}
+	if cleared.MetadataJSON != `{"other":1}` {
+		t.Fatalf("metadata = %s, want the unrelated key kept", cleared.MetadataJSON)
+	}
+
+	if err := source.MoveConversationToTab("conversation-spam", db.TabArchive); !errors.Is(err, sqlite.ErrConversationInSpam) {
+		t.Fatalf("moving a spam thread: err = %v, want ErrConversationInSpam", err)
+	}
+	if got := tabOf("conversation-spam"); got != db.TabSpam {
+		t.Fatalf("spam tab = %q, want %q", got, db.TabSpam)
+	}
+	if err := source.MoveConversationToTab("missing", db.TabArchive); !errors.Is(err, sql.ErrNoRows) {
+		t.Fatalf("moving a missing thread: err = %v, want sql.ErrNoRows", err)
+	}
+}
