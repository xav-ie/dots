+package web
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+
+	"github.com/maxghenis/openmessage/internal/db"
+	"github.com/maxghenis/openmessage/internal/storage/sqlite"
+	"github.com/maxghenis/openmessage/internal/v2read"
+)
+
+func TestConversationTabRoutesWriteV2(t *testing.T) {
+	v2, err := sqlite.Open(filepath.Join(t.TempDir(), "v2.sqlite3"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = v2.Close() })
+	nowMS := time.Now().UnixMilli()
+	if err := v2.UpsertAccount(sqlite.Account{
+		AccountID:   "google-primary",
+		BridgeKey:   "google_messages",
+		DisplayName: "Google",
+		Mode:        sqlite.AccountModeLive,
+		Enabled:     true,
+		ConfigJSON:  "{}",
+		CreatedAtMS: nowMS,
+		UpdatedAtMS: nowMS,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	for id, metadata := range map[string]string{"conv-a": "{}", "conv-b": "{}", "conv-spam": `{"folder":"spam"}`} {
+		if err := v2.UpsertConversation(sqlite.Conversation{
+			ConversationID:       id,
+			AccountID:            "google-primary",
+			RemoteConversationID: "remote-" + id,
+			Kind:                 sqlite.ConversationKindDirect,
+			NotificationMode:     sqlite.NotificationModeAll,
+			MetadataJSON:         metadata,
+			CreatedAtMS:          nowMS,
+			UpdatedAtMS:          nowMS,
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	legacy, err := db.New(":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = legacy.Close() })
+	handler := APIHandlerWithOptions(legacy, nil, zerolog.Nop(), nil, APIOptions{
+		Reads:     v2read.New(v2),
+		V2Primary: true,
+	})
+	do := func(method, path, body string) *httptest.ResponseRecorder {
+		t.Helper()
+		req := httptest.NewRequest(method, "http://127.0.0.1"+path, strings.NewReader(body))
+		req.Header.Set("Origin", "http://127.0.0.1")
+		req.Header.Set("Content-Type", "application/json")
+		resp := httptest.NewRecorder()
+		handler.ServeHTTP(resp, req)
+		return resp
+	}
+
+	resp := do(http.MethodPost, "/api/conversations/conv-a/tab", `{"tab":"archive"}`)
+	if resp.Code != http.StatusOK {
+		t.Fatalf("archive: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+	var convo db.Conversation
+	if err := json.Unmarshal(resp.Body.Bytes(), &convo); err != nil {
+		t.Fatal(err)
+	}
+	if convo.ConversationID != "conv-a" || convo.Tab != db.TabArchive {
+		t.Fatalf("archive answered %+v, want conv-a in archive", convo)
+	}
+
+	if resp := do(http.MethodPost, "/api/conversations/conv-a/tab", `{"tab":"no-such-tab"}`); resp.Code != http.StatusBadRequest {
+		t.Fatalf("unknown tab: status = %d, want 400", resp.Code)
+	}
+	if resp := do(http.MethodPost, "/api/conversations/conv-spam/tab", `{"tab":"archive"}`); resp.Code != http.StatusBadRequest {
+		t.Fatalf("spam thread: status = %d, want 400", resp.Code)
+	}
+	if resp := do(http.MethodPost, "/api/conversations/missing/tab", `{"tab":"archive"}`); resp.Code != http.StatusNotFound {
+		t.Fatalf("missing thread: status = %d, want 404", resp.Code)
+	}
+
+	tab, err := legacy.CreateTab("Work")
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp = do(http.MethodPost, "/api/conversations/move", `{"ids":["conv-a","conv-b","conv-spam","missing"],"tab":"`+tab.TabID+`"}`)
+	if resp.Code != http.StatusOK {
+		t.Fatalf("bulk move: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+	var moved struct {
+		Moved int `json:"moved"`
+	}
+	if err := json.Unmarshal(resp.Body.Bytes(), &moved); err != nil {
+		t.Fatal(err)
+	}
+	if moved.Moved != 2 {
+		t.Fatalf("bulk move moved %d, want 2 (spam and unknown skipped)", moved.Moved)
+	}
+	tabs := func() map[string]string {
+		t.Helper()
+		list, err := v2read.New(v2).ListConversations(10)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got := map[string]string{}
+		for _, conversation := range list {
+			got[conversation.ConversationID] = conversation.Tab
+		}
+		return got
+	}
+	if got := tabs(); got["conv-a"] != tab.TabID || got["conv-b"] != tab.TabID || got["conv-spam"] != db.TabSpam {
+		t.Fatalf("tabs after bulk move = %v", got)
+	}
+
+	if resp := do(http.MethodDelete, "/api/tabs/"+tab.TabID, ""); resp.Code != http.StatusOK {
+		t.Fatalf("delete tab: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+	if got := tabs(); got["conv-a"] != db.TabInbox || got["conv-b"] != db.TabInbox {
+		t.Fatalf("tabs after deleting the tab = %v, want Recent", got)
+	}
+}
