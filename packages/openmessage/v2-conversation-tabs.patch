+package sqlite
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// ErrConversationInSpam means a conversation sits in its transport's spam or
+// blocked folder, which decides its tab; the user can't move it.
+var ErrConversationInSpam = errors.New("conversation is in spam & blocked")
+
+// conversationTabKey holds, in a conversation's metadata_json, the custom tab
+// the user filed it under. Archive is archived_at_ms instead, and the key is
+// absent for the inbox.
+const conversationTabKey = "tab"
+
+// conversationArchiveTab is the built-in tab stored as archived_at_ms.
+const conversationArchiveTab = "archive"
+
+// ConversationTab returns the custom tab stored in a conversation's
+// metadata_json, or "" when it has none.
+func ConversationTab(metadataJSON string) string {
+	var metadata map[string]any
+	if json.Unmarshal([]byte(metadataJSON), &metadata) != nil {
+		return ""
+	}
+	tab, _ := metadata[conversationTabKey].(string)
+	return tab
+}
+
+// SetConversationTab files a conversation under tab: "archive" stamps
+// archived_at_ms (keeping an earlier stamp), "" returns it to the inbox, and
+// any other value is a custom tab id, which the caller validates. A
+// conversation is in one tab at a time, so each move clears the others.
+// Spam and blocked conversations answer ErrConversationInSpam.
+func (s *Store) SetConversationTab(conversationID, tab string, nowMS int64) error {
+	tab = strings.TrimSpace(tab)
+	ctx := context.Background()
+	result, err := s.db.ExecContext(ctx, `
+		UPDATE conversations
+		SET archived_at_ms = CASE WHEN ? = ? THEN COALESCE(archived_at_ms, ?) ELSE NULL END,
+			metadata_json = CASE WHEN ? IN ('', ?)
+				THEN json_remove(metadata_json, '$.`+conversationTabKey+`')
+				ELSE json_set(metadata_json, '$.`+conversationTabKey+`', ?) END,
+			updated_at_ms = MAX(updated_at_ms, ?)
+		WHERE conversation_id = ?
+			AND COALESCE(json_extract(metadata_json, '$.`+conversationFolderKey+`'), '') <> 'spam'
+	`,
+		tab, conversationArchiveTab, nowMS,
+		tab, conversationArchiveTab,
+		tab,
+		nowMS,
+		conversationID,
+	)
+	if err != nil {
+		return fmt.Errorf("set conversation %q tab: %w", conversationID, err)
+	}
+	if updated, err := result.RowsAffected(); err != nil {
+		return fmt.Errorf("set conversation %q tab: %w", conversationID, err)
+	} else if updated > 0 {
+		return nil
+	}
+	var metadataJSON string
+	err = s.db.QueryRowContext(ctx,
+		`SELECT metadata_json FROM conversations WHERE conversation_id = ?`,
+		conversationID,
+	).Scan(&metadataJSON)
+	if errors.Is(err, sql.ErrNoRows) {
+		return fmt.Errorf("set conversation %q tab: %w", conversationID, ErrNotFound)
+	}
+	if err != nil {
+		return fmt.Errorf("set conversation %q tab: %w", conversationID, err)
+	}
+	return fmt.Errorf("set conversation %q tab: %w", conversationID, ErrConversationInSpam)
+}
+
+// ClearConversationTab returns every conversation filed under a deleted
+// custom tab to the inbox.
+func (s *Store) ClearConversationTab(tab string, nowMS int64) error {
+	_, err := s.db.ExecContext(context.Background(), `
+		UPDATE conversations
+		SET metadata_json = json_remove(metadata_json, '$.`+conversationTabKey+`'),
+			updated_at_ms = MAX(updated_at_ms, ?)
+		WHERE json_extract(metadata_json, '$.`+conversationTabKey+`') = ?
+	`, nowMS, strings.TrimSpace(tab))
+	if err != nil {
+		return fmt.Errorf("clear conversation tab %q: %w", tab, err)
+	}
+	return nil
+}
