+	if again.ArchivedAtMS == nil || *again.ArchivedAtMS != *mirrored.ArchivedAtMS {
+		t.Fatalf("archived_at_ms = %v, want %v kept", again.ArchivedAtMS, mirrored.ArchivedAtMS)
