+// SendMedia answers with the transport request ID, the way the Google adapter
+// does: the phone's real ID only arrives with the echo.
+func (s *googleEchoTextSender) SendMedia(
+	_ context.Context,
+	request bridge.MediaRequest,
+) (bridge.SendResult, error) {
+	if s.uncertain {
+		return bridge.SendResult{}, bridge.OpError{
+			Class:     bridge.FailureTransient,
+			Operation: "send_media",
+			Dispatch:  bridge.DispatchUncertain,
+			Cause:     errors.New("transport call timed out"),
+		}
+	}
+	return bridge.SendResult{
+		RemoteMessageID: request.RequestID,
+		AcceptedAt:      s.clock.Now(),
+		EchoExpected:    true,
+	}, nil
+}
