diff --git a/internal/ingest/google_echo_media_test.go b/internal/ingest/google_echo_media_test.go
new file mode 100644
index 0000000..608d284
--- /dev/null
+++ b/internal/ingest/google_echo_media_test.go
@@ -0,0 +1,205 @@
+package ingest
+
+// Google media echoes that carry no TmpID. The phone echoes an image sent
+// from OpenMessage like any other message (raw inbox frames, 2026-10-16),
+// and the echo's TmpID is empty, so before media content pairing the echo
+// projected as a second row: the optimistic local row, bodyless and without
+// the attachment, beside the real image. These tests drive the real service,
+// worker and store against the same ground truth as the text echo tests.
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+
+	"github.com/maxghenis/openmessage/internal/messaging"
+)
+
+// googleEchoMediaMessage is an outgoing media frame with no TmpID, the shape
+// the phone echoes for an image sent from OpenMessage. A caption rides in a
+// text entry beside the media one, as in a live frame.
+func googleEchoMediaMessage(
+	remoteID string,
+	mediaID string,
+	caption string,
+	status gmproto.MessageStatusType,
+	occurredAt time.Time,
+) *gmproto.Message {
+	message := googleEchoMessage(remoteID, "", caption, true, occurredAt)
+	message.MessageStatus = &gmproto.MessageStatus{Status: status}
+	if caption == "" {
+		// An uncaptioned echo carries the media entry alone.
+		message.MessageInfo = nil
+	}
+	message.MessageInfo = append(message.MessageInfo, &gmproto.MessageInfo{
+		Data: &gmproto.MessageInfo_MediaContent{MediaContent: &gmproto.MediaContent{
+			MediaID: mediaID, DecryptionKey: []byte{0x01, 0x02}, MimeType: "image/jpeg",
+		}},
+	})
+	return message
+}
+
+// mediaEcho delivers an outgoing media frame with no TmpID that this machine
+// receives at arrivedAt. A reconcile error fails the test.
+func (h *googleEchoHarness) mediaEcho(
+	t *testing.T,
+	remoteID, mediaID, caption string,
+	status gmproto.MessageStatusType,
+	arrivedAt time.Time,
+) {
+	t.Helper()
+	if arrivedAt.Before(h.clock.Now()) {
+		t.Fatalf("media echo arrives at %v, before the clock's %v", arrivedAt, h.clock.Now())
+	}
+	h.clock.Set(arrivedAt)
+	h.appendMessage(t, googleEchoMediaMessage(remoteID, mediaID, caption, status, arrivedAt.Add(phoneClockOffset)))
+	h.waitDrained(t)
+	if errors := h.counters.Snapshot(googleEchoAccountID).EchoErrors; errors != 0 {
+		t.Fatalf("media echo reconcile failed %d times", errors)
+	}
+}
+
+// sendMediaAt submits an image at createdAt and confirms it at sentAt. The
+// sender answers with the transport request ID, as the Google adapter does.
+func (h *googleEchoHarness) sendMediaAt(
+	t *testing.T,
+	key, caption string,
+	createdAt, sentAt time.Time,
+) messaging.Submission {
+	t.Helper()
+	h.clock.Set(createdAt)
+	submission, err := h.service.SendMedia(context.Background(), messaging.SendMediaCommand{
+		CommonCommand: messaging.CommonCommand{
+			AccountID:      googleEchoAccountID,
+			ConversationID: googleEchoConversationID,
+			IdempotencyKey: "google-echo-" + key,
+		},
+		Content:  strings.NewReader("png bytes for " + key),
+		Filename: "photo.png",
+		MIME:     "image/png",
+		Caption:  caption,
+	})
+	if err != nil {
+		t.Fatalf("MessageService.SendMedia(): %v", err)
+	}
+	h.clock.Set(sentAt)
+	h.confirm(t, submission.OutboxID)
+	return submission
+}
+
+func (h *googleEchoHarness) attachmentCount(t *testing.T, messageID string) int {
+	t.Helper()
+	return countSQLiteRows(t, h.storePath,
+		"SELECT COUNT(*) FROM message_attachments WHERE message_id = ?", messageID)
+}
+
+// The live sequence for an image sent without a caption: the phone echoes it
+// without a TmpID, once per status change, and every frame carries the media.
+func TestGoogleMediaEchoWithoutTmpIDMergesIntoTheSentMessage(t *testing.T) {
+	h := newGoogleEchoHarness(t, nil)
+	send := h.sendMediaAt(t, "untagged", "", googleEchoNow, googleEchoNow.Add(time.Second))
+	h.mediaEcho(t, "89107", "media-1", "", complete, googleEchoNow.Add(1800*time.Millisecond))
+	h.mediaEcho(t, "89107", "media-1", "", delivered, googleEchoNow.Add(3*time.Second))
+
+	h.assertBound(t, send, "89107")
+	if got := h.countV2Messages(t); got != 1 {
+		t.Fatalf("messages = %d, want one", got)
+	}
+	if got := h.attachmentCount(t, send.LocalMessageID); got != 1 {
+		t.Fatalf("attachments on the local row = %d, want the echoed image", got)
+	}
+	if snapshot := h.counters.Snapshot(googleEchoAccountID); snapshot.EchoContentMatched != 1 || snapshot.EchoErrors != 0 {
+		t.Fatalf("counters = %+v, want one content match and no errors", snapshot)
+	}
+}
+
+// A captioned image pairs by its caption: the echo's attachment tells it from
+// the echo of a text send of the same words.
+func TestGoogleMediaEchoWithCaptionMergesByCaption(t *testing.T) {
+	h := newGoogleEchoHarness(t, nil)
+	send := h.sendMediaAt(t, "captioned", "look at this", googleEchoNow, googleEchoNow.Add(time.Second))
+	h.mediaEcho(t, "89108", "media-2", "look at this", complete, googleEchoNow.Add(1800*time.Millisecond))
+
+	h.assertBound(t, send, "89108")
+	if got := h.countV2Messages(t); got != 1 {
+		t.Fatalf("messages = %d, want one", got)
+	}
+	if got := h.attachmentCount(t, send.LocalMessageID); got != 1 {
+		t.Fatalf("attachments on the local row = %d, want the echoed image", got)
+	}
+}
+
+// The echo row may already sit beside the optimistic row, as on the live
+// store: the startup repair pairs and merges them, and the image lands on the
+// surviving local row.
+func TestRepairMergesAMediaEchoThatAlreadyProjected(t *testing.T) {
+	h := newGoogleEchoHarnessWithObserver(t, nil, preFixObserver)
+	send := h.sendMediaAt(t, "prefix", "", googleEchoNow, googleEchoNow.Add(time.Second))
+	h.mediaEcho(t, "89201", "media-3", "", delivered, googleEchoNow.Add(1800*time.Millisecond))
+	if got := h.countV2Messages(t); got != 2 {
+		t.Fatalf("messages before repair = %d, want the local row and the echo row", got)
+	}
+
+	report, err := h.service.RepairUncorrelatedEchoDuplicates(context.Background())
+	if err != nil || report.Merged != 1 {
+		t.Fatalf("repair = %+v, %v; want one merge", report, err)
+	}
+	h.assertBound(t, send, "89201")
+	if got := h.countV2Messages(t); got != 1 {
+		t.Fatalf("messages after repair = %d, want one", got)
+	}
+	if got := h.attachmentCount(t, send.LocalMessageID); got != 1 {
+		t.Fatalf("attachments on the local row = %d, want the echoed image", got)
+	}
+	again, err := h.service.RepairUncorrelatedEchoDuplicates(context.Background())
+	if err != nil || again.Merged != 0 {
+		t.Fatalf("second repair = %+v, %v; want nothing left to do", again, err)
+	}
+}
+
+// A media echo never takes the echo of a text send of the same caption, and a
+// text echo never takes a media send's: the candidate sets are disjoint.
+func TestMediaAndTextEchoesOfTheSameWordsStayDisjoint(t *testing.T) {
+	h := newGoogleEchoHarness(t, nil)
+	textSend := h.sendAt(t, "text", "look at this", googleEchoNow, googleEchoNow)
+	h.mediaEcho(t, "89301", "media-4", "", complete, googleEchoNow.Add(800*time.Millisecond))
+	if delivery := h.delivery(t, textSend.OutboxID); delivery.RemoteMessageID == "89301" {
+		t.Fatalf("text send took the media echo: %+v", delivery)
+	}
+
+	// The text send's own echo pairs it; the phone's image stays its own row.
+	h.echo(t, "89302", "look at this", complete, googleEchoNow.Add(1300*time.Millisecond))
+	h.assertBound(t, textSend, "89302")
+
+	mediaSend := h.sendMediaAt(t, "media", "look at this",
+		googleEchoNow.Add(10*time.Second), googleEchoNow.Add(10*time.Second))
+	// A text echo of the same caption must not take the media send, whose
+	// own echo arrives right after it.
+	h.echo(t, "89303", "look at this", complete, googleEchoNow.Add(10800*time.Millisecond))
+	if delivery := h.delivery(t, mediaSend.OutboxID); delivery.RemoteMessageID == "89303" {
+		t.Fatalf("media send took the text echo: %+v", delivery)
+	}
+	h.mediaEcho(t, "89304", "media-5", "look at this", complete, googleEchoNow.Add(11600*time.Millisecond))
+	h.assertBound(t, mediaSend, "89304")
+	// Four rows stay: the two sends, the phone's image, and the late untagged
+	// text — indistinguishable from one typed on the phone, so its own row.
+	if got := h.countV2Messages(t); got != 4 {
+		t.Fatalf("messages = %d, want the two sends, the phone's image and the phone's text", got)
+	}
+}
+
+// An image sent from the phone itself has no send here to pair with; it stays
+// its own message and the pairing is a successful no-op.
+func TestGoogleMediaEchoOfAPhoneSentImageStaysItsOwnRow(t *testing.T) {
+	h := newGoogleEchoHarness(t, nil)
+	h.mediaEcho(t, "89401", "media-6", "", complete, googleEchoNow)
+	if got := h.countV2Messages(t); got != 1 {
+		t.Fatalf("messages = %d, want the phone's image alone", got)
+	}
+	if snapshot := h.counters.Snapshot(googleEchoAccountID); snapshot.EchoContentMatched != 0 || snapshot.EchoErrors != 0 {
+		t.Fatalf("counters = %+v, want no content match and no errors", snapshot)
+	}
+}
