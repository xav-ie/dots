diff --git a/internal/client/rcs_profile.go b/internal/client/rcs_profile.go
new file mode 100644
index 0000000..ac688c8
--- /dev/null
+++ b/internal/client/rcs_profile.go
@@ -0,0 +1,91 @@
+package client
+
+import (
+	"strings"
+
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+	"google.golang.org/protobuf/encoding/protowire"
+)
+
+// participantRCSProfileField is the Participant field carrying the name an RCS
+// sender set on their own profile, as {1: name, 2: name}. libgm doesn't
+// decode it, so it arrives among the unknown fields.
+const participantRCSProfileField protowire.Number = 21
+
+// ParticipantRCSProfileName returns the name an RCS sender chose for
+// themselves, or "" when they shared none.
+func ParticipantRCSProfileName(p *gmproto.Participant) string {
+	if p == nil {
+		return ""
+	}
+	b := p.ProtoReflect().GetUnknown()
+	for len(b) > 0 {
+		num, typ, n := protowire.ConsumeTag(b)
+		if n < 0 {
+			return ""
+		}
+		b = b[n:]
+		if num != participantRCSProfileField || typ != protowire.BytesType {
+			n = protowire.ConsumeFieldValue(num, typ, b)
+			if n < 0 {
+				return ""
+			}
+			b = b[n:]
+			continue
+		}
+		profile, n := protowire.ConsumeBytes(b)
+		if n < 0 {
+			return ""
+		}
+		return rcsProfileName(profile)
+	}
+	return ""
+}
+
+func rcsProfileName(b []byte) string {
+	var fallback string
+	for len(b) > 0 {
+		num, typ, n := protowire.ConsumeTag(b)
+		if n < 0 {
+			break
+		}
+		b = b[n:]
+		if typ != protowire.BytesType {
+			n = protowire.ConsumeFieldValue(num, typ, b)
+			if n < 0 {
+				break
+			}
+			b = b[n:]
+			continue
+		}
+		v, n := protowire.ConsumeBytes(b)
+		if n < 0 {
+			break
+		}
+		b = b[n:]
+		name := strings.TrimSpace(string(v))
+		if num == 1 && name != "" {
+			return name
+		}
+		if num == 2 && fallback == "" {
+			fallback = name
+		}
+	}
+	return fallback
+}
+
+// ParticipantDisplayName is the participant's contact name, or else the name
+// they set on their RCS profile, marked with "~" as Google Messages does so it
+// never passes for a saved contact.
+func ParticipantDisplayName(p *gmproto.Participant) string {
+	if name := strings.TrimSpace(p.GetFullName()); name != "" {
+		return name
+	}
+	if name := strings.TrimSpace(p.GetFirstName()); name != "" {
+		return name
+	}
+	if name := ParticipantRCSProfileName(p); name != "" {
+		return "~" + name
+	}
+	return ""
+}
diff --git a/internal/client/rcs_profile_test.go b/internal/client/rcs_profile_test.go
new file mode 100644
index 0000000..717b4ad
--- /dev/null
+++ b/internal/client/rcs_profile_test.go
@@ -0,0 +1,59 @@
+package client
+
+import (
+	"testing"
+
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+	"google.golang.org/protobuf/encoding/protowire"
+	"google.golang.org/protobuf/proto"
+)
+
+// participantWithProfile builds a Participant as Google sends it, with the
+// RCS profile name in field 21 that libgm keeps as an unknown field.
+func participantWithProfile(t *testing.T, p *gmproto.Participant, profile ...string) *gmproto.Participant {
+	t.Helper()
+	raw, err := proto.Marshal(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var inner []byte
+	for i, name := range profile {
+		inner = protowire.AppendTag(inner, protowire.Number(i+1), protowire.BytesType)
+		inner = protowire.AppendString(inner, name)
+	}
+	raw = protowire.AppendTag(raw, participantRCSProfileField, protowire.BytesType)
+	raw = protowire.AppendBytes(raw, inner)
+	var out gmproto.Participant
+	if err := proto.Unmarshal(raw, &out); err != nil {
+		t.Fatal(err)
+	}
+	return &out
+}
+
+func TestParticipantDisplayName(t *testing.T) {
+	number := &gmproto.SmallInfo{Number: "+14805550100", ParticipantID: "1232"}
+	for _, tc := range []struct {
+		name string
+		p    *gmproto.Participant
+		want string
+	}{
+		{"profile only", participantWithProfile(t, &gmproto.Participant{ID: number, FormattedNumber: "(480) 555-0100"}, "123bigred", "123bigred"), "~123bigred"},
+		{"second field only", participantWithProfile(t, &gmproto.Participant{ID: number}, "", "bigred"), "~bigred"},
+		{"contact wins", participantWithProfile(t, &gmproto.Participant{ID: number, FullName: "Big Red"}, "123bigred"), "Big Red"},
+		{"first name wins", participantWithProfile(t, &gmproto.Participant{ID: number, FirstName: "Red"}, "123bigred"), "Red"},
+		{"no profile", &gmproto.Participant{ID: number, FormattedNumber: "(480) 555-0100"}, ""},
+		{"nil", nil, ""},
+	} {
+		if got := ParticipantDisplayName(tc.p); got != tc.want {
+			t.Errorf("%s: ParticipantDisplayName = %q, want %q", tc.name, got, tc.want)
+		}
+	}
+}
+
+func TestExtractSenderInfoUsesRCSProfileName(t *testing.T) {
+	sender := participantWithProfile(t, &gmproto.Participant{ID: &gmproto.SmallInfo{Number: "+14805550100"}}, "123bigred", "123bigred")
+	name, number := ExtractSenderInfo(&gmproto.Message{SenderParticipant: sender})
+	if name != "~123bigred" || number != "+14805550100" {
+		t.Fatalf("ExtractSenderInfo = %q, %q", name, number)
+	}
+}
