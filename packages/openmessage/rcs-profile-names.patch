diff --git a/internal/ingest/rcs_profile_title_test.go b/internal/ingest/rcs_profile_title_test.go
new file mode 100644
index 0000000..70201a7
--- /dev/null
+++ b/internal/ingest/rcs_profile_title_test.go
@@ -0,0 +1,64 @@
+package ingest
+
+import (
+	"testing"
+
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+	"google.golang.org/protobuf/encoding/protowire"
+	"google.golang.org/protobuf/proto"
+)
+
+func withRCSProfile(t *testing.T, p *gmproto.Participant, name string) *gmproto.Participant {
+	t.Helper()
+	raw, err := proto.Marshal(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inner := protowire.AppendString(protowire.AppendTag(nil, 1, protowire.BytesType), name)
+	raw = protowire.AppendBytes(protowire.AppendTag(raw, 21, protowire.BytesType), inner)
+	var out gmproto.Participant
+	if err := proto.Unmarshal(raw, &out); err != nil {
+		t.Fatal(err)
+	}
+	return &out
+}
+
+func TestGoogleConversationEventUsesRCSProfileName(t *testing.T) {
+	me := &gmproto.Participant{ID: &gmproto.SmallInfo{Number: "+16025550100"}, FullName: "Me", IsMe: true}
+	peer := withRCSProfile(t, &gmproto.Participant{ID: &gmproto.SmallInfo{Number: "+14805550100"}, FormattedNumber: "(480) 555-0100"}, "123bigred")
+
+	event := googleConversationEvent(&gmproto.Conversation{
+		ConversationID: "1178",
+		Name:           "(480) 555-0100",
+		Participants:   []*gmproto.Participant{me, peer},
+	})
+	if got := event.Conversation.Title; got != "~123bigred" {
+		t.Errorf("direct title = %q, want ~123bigred", got)
+	}
+	if got := event.Conversation.Participants[1].Identity.Name; got != "~123bigred" {
+		t.Errorf("peer name = %q, want ~123bigred", got)
+	}
+
+	saved := withRCSProfile(t, &gmproto.Participant{ID: &gmproto.SmallInfo{Number: "+14805550100"}, FullName: "Big Red"}, "123bigred")
+	event = googleConversationEvent(&gmproto.Conversation{
+		ConversationID: "1178",
+		Name:           "Big Red",
+		Participants:   []*gmproto.Participant{me, saved},
+	})
+	if got := event.Conversation.Title; got != "Big Red" {
+		t.Errorf("contact title = %q, want Big Red", got)
+	}
+
+	event = googleConversationEvent(&gmproto.Conversation{
+		ConversationID: "2000",
+		Name:           "Weekend plans",
+		IsGroupChat:    true,
+		Participants:   []*gmproto.Participant{me, peer},
+	})
+	if got := event.Conversation.Title; got != "Weekend plans" {
+		t.Errorf("group title = %q, want Weekend plans", got)
+	}
+	if got := event.Conversation.Participants[1].Identity.Name; got != "~123bigred" {
+		t.Errorf("group member name = %q, want ~123bigred", got)
+	}
+}
