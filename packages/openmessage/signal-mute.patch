+// SetRemoteMute installs the check for conversations muted on the user's
+// phone, which read as NotificationMode "muted" while the mute lasts.
+func (s *Source) SetRemoteMute(muted func(platform, remoteConversationID string) bool) {
+	s.mutedRemotely = muted
+}
