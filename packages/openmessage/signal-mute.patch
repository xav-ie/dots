 		LastMessageTS:    conversation.LastMessageAtMS,
 		SourcePlatform:   platformForBridgeKey(account.BridgeKey),
 		IsFavorite:       conversation.IsFavorite,
-		NotificationMode: string(conversation.NotificationMode),
+		NotificationMode: s.notificationMode(conversation, platformForBridgeKey(account.BridgeKey)),
 		Tab:              conversationTab(conversation),
 	}, nil
 }
@@ -392,3 +392,13 @@ func (s *Source) sendStatusForMessage(message sqlite.Message) (string, error) {
 		return "", nil
 	}
 }
+
+// notificationMode is the conversation's own mode, overridden to muted while
+// the user's phone has it muted, so OpenMessage never notifies for a thread
+// the phone silences.
+func (s *Source) notificationMode(conversation sqlite.Conversation, platform string) string {
+	if s.mutedRemotely != nil && s.mutedRemotely(platform, conversation.RemoteConversationID) {
+		return string(sqlite.NotificationModeMuted)
+	}
+	return string(conversation.NotificationMode)
+}
