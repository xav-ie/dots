+// backfillArchiveFolder lists the newest archived threads and fetches the
+// messages any of them is missing. Threads archived on the phone are not in
+// the INBOX listing above, so without this they kept only their conversation
+// row: listed with a recent time, opening to nothing. A thread whose newest
+// message is already stored costs no fetch. Reports whether the connection
+// generation ended; any other failure is logged and never fails the startup
+// backfill.
+func (a *App) backfillArchiveFolder(catchUp *googleCatchUp) bool {
+	folder := gmproto.ListConversationsRequest_ARCHIVE
+	// Not recorded as a pull, like backfillSpamFolder.
+	resp, err := catchUp.gm.ListConversationsWithCursor(100, folder, nil)
+	if err != nil {
+		a.HandleGoogleAuthExpiredError(err)
+		a.Logger.Warn().Err(err).Msg("Failed to list archived conversations")
+		return false
+	}
+	fetched := 0
+	for _, conv := range resp.GetConversations() {
+		if err := catchUp.storeConversation(conv); err != nil {
+			if errors.Is(err, ErrGoogleHistoryClosed) {
+				return true
+			}
+			a.Logger.Error().Err(err).Str("conv_id", conv.GetConversationID()).Msg("Failed to store conversation")
+			continue
+		}
+		if a.conversationHasLatestMessage(conv) {
+			continue
+		}
+		stored, aborted := a.reconcileRecentConversationMessages(catchUp, conv)
+		if aborted {
+			return catchUp.closed
+		}
+		if stored {
+			fetched++
+		}
+	}
+	a.Logger.Info().
+		Int("conversations", len(resp.GetConversations())).
+		Int("fetched", fetched).
+		Msg("Archived conversations backfilled")
+	return false
+}
+
+// conversationHasLatestMessage reports whether the newest message Google
+// lists for conv is already stored.
+func (a *App) conversationHasLatestMessage(conv *gmproto.Conversation) bool {
+	latestMS := conv.GetLastMessageTimestamp() / 1000
+	if latestMS <= 0 {
+		return false
+	}
+	local, err := a.Store.GetMessagesByConversation(conv.GetConversationID(), 1)
+	if err != nil || len(local) == 0 {
+		return false
+	}
+	return local[0].TimestampMS >= latestMS
+}
+
+// ErrHistoryFetchRunning reports that an on-demand fetch for the same
+// conversation is already running.
+var ErrHistoryFetchRunning = errors.New("history fetch already running")
+
+// FetchConversationHistory fetches a Google conversation's newest messages
+// on demand, for a thread opened with nothing stored, and returns how many
+// the phone returned (0: the phone holds none). The rest of the thread's
+// history follows in the background.
+func (a *App) FetchConversationHistory(convID string) (int, error) {
+	convID = strings.TrimSpace(convID)
+	if convID == "" {
+		return 0, fmt.Errorf("conversation id is required")
+	}
+	if _, running := a.historyFetches.LoadOrStore(convID, struct{}{}); running {
+		return 0, ErrHistoryFetchRunning
+	}
+	release := func() { a.historyFetches.Delete(convID) }
+
+	catchUp := a.beginGoogleCatchUp("conversation_fetch")
+	if catchUp == nil {
+		release()
+		return 0, fmt.Errorf("client not connected")
+	}
+	resp, err := catchUp.gm.FetchMessages(convID, 50, nil)
+	if err != nil {
+		catchUp.finish()
+		release()
+		a.HandleGoogleAuthExpiredError(err)
+		return 0, fmt.Errorf("fetch messages: %w", err)
+	}
+	msgs := resp.GetMessages()
+	for _, msg := range oldestFirst(msgs) {
+		catchUp.storeMessage(convID, nil, msg)
+	}
+	catchUp.finish()
+	a.emitConversationsChange()
+	a.emitMessagesChange(convID)
+	if len(msgs) == 0 || resp.GetCursor() == nil {
+		release()
+		return len(msgs), nil
+	}
+
+	go func() {
+		defer release()
+		rest := a.beginGoogleCatchUp("conversation_fetch")
+		if rest == nil {
+			return
+		}
+		defer rest.finish()
+		// A one-shot user request, like a phone backfill: it finishes even if
+		// the client reconnects meanwhile.
+		rest.token = nil
+		n, _ := a.deepBackfillConversationWithToken(rest, convID, nil, 0)
+		a.Logger.Info().Str("conv_id", convID).Int("messages", n).Msg("Conversation history fetch complete")
+		a.emitMessagesChange(convID)
+	}()
+	return len(msgs), nil
+}
+
