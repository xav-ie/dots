+)
+
+// Threads archived on the phone are not in the startup INBOX listing; the
+// startup backfill fetches the messages they lack, and skips one whose newest
+// message is already stored.
+func TestBackfillFetchesArchivedThreadsMissingMessages(t *testing.T) {
+	current := makeConv("a-current", "Current")
+	missing := makeConv("a-missing", "Missing")
+	mock := &mockGMClient{
+		conversations: map[gmproto.ListConversationsRequest_Folder][][]*gmproto.Conversation{
+			gmproto.ListConversationsRequest_ARCHIVE: {{current, missing}},
+		},
+		messages: map[string][][]*gmproto.Message{
+			"a-current": {{makeMsg("c-1", "a-current", "stored already", 1000)}},
+			"a-missing": {{makeMsg("m-2", "a-missing", "newer", 1000), makeMsg("m-1", "a-missing", "older", 900)}},
+		},
+	}
+	a, gm, legacyDB := hcdNewApp(t, mock, nil)
+	if err := a.Store.UpsertMessage(&db.Message{
+		MessageID:      "c-1",
+		ConversationID: "a-current",
+		Body:           "stored already",
+		TimestampMS:    1000,
+		Status:         "MESSAGE_STATUS_INCOMING_COMPLETE",
+		SourcePlatform: "sms",
+	}); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := a.Backfill(); err != nil {
+		t.Fatalf("Backfill(): %v", err)
+	}
+
+	for _, call := range gm.fetches {
+		if call.ConversationID == "a-current" {
+			t.Errorf("fetched a-current, whose newest message is stored: %+v", gm.fetches)
+		}
+	}
+	legacy := hcdLegacyMessages(t, legacyDB)
+	for _, id := range []string{"m-1", "m-2"} {
+		if legacy[id].ConversationID != "a-missing" {
+			t.Errorf("archived thread message %s not stored: %+v", id, legacy[id])
+		}
+	}
+}
+
+func TestFetchConversationHistory(t *testing.T) {
+	mock := &mockGMClient{
+		messages: map[string][][]*gmproto.Message{
+			"t1": {
+				{makeMsg("t1-5", "t1", "five", 5000), makeMsg("t1-4", "t1", "four", 4000), makeMsg("t1-3", "t1", "three", 3000)},
+				{makeMsg("t1-2", "t1", "two", 2000), makeMsg("t1-1", "t1", "one", 1000)},
+			},
+		},
+	}
+	a, _, legacyDB := hcdNewApp(t, mock, nil)
+
+	n, err := a.FetchConversationHistory("t1")
+	if err != nil || n != 3 {
+		t.Fatalf("FetchConversationHistory(t1) = %d, %v; want 3, nil", n, err)
+	}
+	// The rest of the thread follows in the background.
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		if _, running := a.historyFetches.Load("t1"); !running {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("background history fetch never finished")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	legacy := hcdLegacyMessages(t, legacyDB)
+	for _, id := range []string{"t1-1", "t1-2", "t1-3", "t1-4", "t1-5"} {
+		if legacy[id].ConversationID != "t1" {
+			t.Errorf("message %s not stored", id)
+		}
+	}
+
+	n, err = a.FetchConversationHistory("t-empty")
+	if err != nil || n != 0 {
+		t.Fatalf("FetchConversationHistory(t-empty) = %d, %v; want 0, nil", n, err)
+	}
+	if _, running := a.historyFetches.Load("t-empty"); running {
+		t.Error("a fetch the phone answered with nothing stayed marked running")
+	}
+
+	a.historyFetches.Store("busy", struct{}{})
+	if _, err := a.FetchConversationHistory("busy"); !errors.Is(err, ErrHistoryFetchRunning) {
+		t.Errorf("second fetch of a running thread = %v, want ErrHistoryFetchRunning", err)
+	}
+}
