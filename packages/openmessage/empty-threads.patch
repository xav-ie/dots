+)
+
+func TestGoogleConversationArchived(t *testing.T) {
+	yes, no := true, false
+	for status, want := range map[gmproto.ConversationStatus]*bool{
+		gmproto.ConversationStatus_UNKNOWN_CONVERSATION_STATUS: nil,
+		gmproto.ConversationStatus_ACTIVE:                      &no,
+		gmproto.ConversationStatus_ARCHIVED:                    &yes,
+		gmproto.ConversationStatus_KEEP_ARCHIVED:               &yes,
+		gmproto.ConversationStatus_DELETED:                     nil,
+		gmproto.ConversationStatus_SPAM_FOLDER:                 nil,
+		gmproto.ConversationStatus_BLOCKED_FOLDER:              nil,
+	} {
+		got := googleConversationArchived(status)
+		if (got == nil) != (want == nil) || (got != nil && *got != *want) {
+			t.Errorf("googleConversationArchived(%s) = %v, want %v", status, got, want)
+		}
+	}
+	event := googleConversationEvent(&gmproto.Conversation{ConversationID: "1", Status: gmproto.ConversationStatus_ARCHIVED})
+	if archived := event.Conversation.Archived; archived == nil || !*archived {
+		t.Errorf("archived snapshot event Archived = %v, want true", archived)
+	}
+}
+
+// The phone's archive state drives archived_at_ms on live and history
+// snapshots alike; a status that says nothing leaves it, and a custom tab
+// the user filed the thread under survives all of it.
+func TestConversationArchiveFollowsGoogleStatus(t *testing.T) {
+	h := newHWTHarness(t, false)
+	stored := func() sqlite.Conversation {
+		t.Helper()
+		return h.conversation(t, "hwt-archive")
+	}
+	snapshot := func(status gmproto.ConversationStatus) *gmproto.Conversation {
+		conversation := hwtConversation("hwt-archive", "", false, hwtKarl)
+		conversation.Status = status
+		return conversation
+	}
+
+	h.liveConversation(t, snapshot(gmproto.ConversationStatus_ACTIVE))
+	h.pump(t)
+	if got := stored().ArchivedAtMS; got != nil {
+		t.Fatalf("active thread archived_at_ms = %d, want unarchived", *got)
+	}
+	if err := h.store.SetConversationTab(stored().ConversationID, "work", 1); err != nil {
+		t.Fatal(err)
+	}
+
+	h.liveConversation(t, snapshot(gmproto.ConversationStatus_ARCHIVED))
+	h.pump(t)
+	first := stored().ArchivedAtMS
+	if first == nil {
+		t.Fatal("after an archived live snapshot the thread is not archived")
+	}
+	if tab := sqlite.ConversationTab(stored().MetadataJSON); tab != "work" {
+		t.Fatalf("custom tab after archiving = %q, want work", tab)
+	}
+
+	h.historyConversation(t, snapshot(gmproto.ConversationStatus_KEEP_ARCHIVED))
+	h.pump(t)
+	if got := stored().ArchivedAtMS; got == nil || *got != *first {
+		t.Fatalf("archived_at_ms after a second archived snapshot = %v, want %d kept", got, *first)
+	}
+
+	h.historyConversation(t, snapshot(gmproto.ConversationStatus_UNKNOWN_CONVERSATION_STATUS))
+	h.pump(t)
+	if stored().ArchivedAtMS == nil {
+		t.Fatal("a status-less snapshot unarchived the thread")
+	}
+
+	h.historyConversation(t, snapshot(gmproto.ConversationStatus_ACTIVE))
+	h.pump(t)
+	if got := stored().ArchivedAtMS; got != nil {
+		t.Fatalf("after an active history snapshot archived_at_ms = %d, want unarchived", *got)
+	}
+	if tab := sqlite.ConversationTab(stored().MetadataJSON); tab != "work" {
+		t.Fatalf("custom tab after unarchiving = %q, want work", tab)
+	}
+}
