+// applyConversationArchived mirrors the transport's archive state onto
+// conversation: archived keeps an existing archive time (or takes nowMS),
+// unarchived clears it, nil leaves it. A custom tab in metadata_json is not
+// touched. Reports whether anything changed.
+func applyConversationArchived(conversation *sqlite.Conversation, archived *bool, nowMS int64) bool {
+	switch {
+	case archived == nil:
+		return false
+	case *archived:
+		if conversation.ArchivedAtMS != nil {
+			return false
+		}
+		conversation.ArchivedAtMS = &nowMS
+		return true
+	default:
+		if conversation.ArchivedAtMS == nil {
+			return false
+		}
+		conversation.ArchivedAtMS = nil
+		return true
+	}
+}
