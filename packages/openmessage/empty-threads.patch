+var errPhoneArchive = errors.New("phone archive failed")
+
+// moveConversationTab moves a v2 conversation into tab, archiving or
+// unarchiving a Google thread on the phone first whenever the move changes
+// whether it is archived: into Archive archives it, out of Archive (to Recent
+// or a custom tab) unarchives it. The phone goes first so a refusal leaves
+// both sides as they were; a local failure after it is undone on the phone.
+// Other platforms' threads, and moves that keep the archive state, stay
+// local.
+func moveConversationTab(
+	reads readsource.ReadSource,
+	tabs conversationTabMover,
+	setArchived func(remoteID string, archived bool) error,
+	convID, tab string,
+) error {
+	if setArchived == nil {
+		return tabs.MoveConversationToTab(convID, tab)
+	}
+	convo, err := reads.GetConversation(convID)
+	if err != nil {
+		return err
+	}
+	wasArchived := convo.Tab == db.TabArchive
+	archive := tab == db.TabArchive
+	if convo.SourcePlatform != "sms" || convo.Tab == db.TabSpam || wasArchived == archive {
+		return tabs.MoveConversationToTab(convID, tab)
+	}
+	remoteID, err := conversationRemoteID(reads, convID)
+	if err != nil {
+		return err
+	}
+	if err := setArchived(remoteID, archive); err != nil {
+		return fmt.Errorf("%w: %w", errPhoneArchive, err)
+	}
+	if err := tabs.MoveConversationToTab(convID, tab); err != nil {
+		_ = setArchived(remoteID, wasArchived)
+		return err
+	}
+	return nil
+}
