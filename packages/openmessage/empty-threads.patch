+// restampConversationFolder stores folder and archive state on an existing
+// conversation when they differ from the stored ones.
+func (w *Worker) restampConversationFolder(conversation sqlite.Conversation, folder string, archived *bool) error {
+	metadata, folderChanged, err := sqlite.WithConversationFolder(conversation.MetadataJSON, folder)
+	if err != nil {
 		return err
 	}
 	conversation.MetadataJSON = metadata
+	var nowMS int64
+	if archived != nil && *archived && conversation.ArchivedAtMS == nil {
+		if nowMS, err = w.nowMS(); err != nil {
+			return err
+		}
