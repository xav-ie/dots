+	var body struct {
+		Fetched int  `json:"fetched"`
+		Running bool `json:"running"`
+	}
+	if err := json.Unmarshal(resp.Body.Bytes(), &body); err != nil {
+		t.Fatal(err)
+	}
+	if body.Fetched != 7 || body.Running {
+		t.Errorf("fetch answered %+v, want fetched 7", body)
+	}
+
+	resp = do(http.MethodPost, "/api/conversations/conv-busy/fetch-history")
+	body = struct {
+		Fetched int  `json:"fetched"`
+		Running bool `json:"running"`
+	}{}
+	if err := json.Unmarshal(resp.Body.Bytes(), &body); err != nil || resp.Code != http.StatusOK || !body.Running {
+		t.Errorf("running fetch: status = %d body = %s, want 200 running", resp.Code, resp.Body.String())
+	}
+
+	if resp := do(http.MethodPost, "/api/conversations/conv-signal/fetch-history"); resp.Code != http.StatusConflict {
+		t.Errorf("signal thread: status = %d, want 409", resp.Code)
+	}
+	if resp := do(http.MethodPost, "/api/conversations/missing/fetch-history"); resp.Code != http.StatusNotFound {
+		t.Errorf("missing thread: status = %d, want 404", resp.Code)
+	}
+	if resp := do(http.MethodGet, "/api/conversations/conv-sms/fetch-history"); resp.Code != http.StatusMethodNotAllowed {
+		t.Errorf("GET: status = %d, want 405", resp.Code)
+	}
+	if want := []string{"remote-conv-sms", "remote-conv-busy"}; strings.Join(fetched, ",") != strings.Join(want, ",") {
+		t.Errorf("fetched remote IDs = %v, want %v", fetched, want)
+	}
+}
