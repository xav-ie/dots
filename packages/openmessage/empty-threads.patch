index 0000000..8649147
--- /dev/null
+++ b/internal/web/archive_sync_test.go
@@ -0,0 +1,161 @@
+package web
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+
+	"github.com/maxghenis/openmessage/internal/db"
+	"github.com/maxghenis/openmessage/internal/storage/sqlite"
+	"github.com/maxghenis/openmessage/internal/v2read"
+)
+
+// Archiving or unarchiving a Google thread from the UI does the same on the
+// phone, before the local move; a refusal leaves the thread where it was.
+func TestTabMovesArchiveGoogleThreadsOnPhone(t *testing.T) {
+	v2, err := sqlite.Open(filepath.Join(t.TempDir(), "v2.sqlite3"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = v2.Close() })
+	nowMS := time.Now().UnixMilli()
+	for account, bridge := range map[string]string{"google-primary": "google_messages", "signal-primary": "signal_cli"} {
+		if err := v2.UpsertAccount(sqlite.Account{
+			AccountID:   account,
+			BridgeKey:   bridge,
+			DisplayName: account,
+			Mode:        sqlite.AccountModeLive,
+			Enabled:     true,
+			ConfigJSON:  "{}",
+			CreatedAtMS: nowMS,
+			UpdatedAtMS: nowMS,
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for id, account := range map[string]string{
+		"conv-a": "google-primary", "conv-b": "google-primary", "conv-c": "google-primary",
+		"conv-refused": "google-primary", "conv-signal": "signal-primary",
+	} {
+		if err := v2.UpsertConversation(sqlite.Conversation{
+			ConversationID:       id,
+			AccountID:            account,
+			RemoteConversationID: "remote-" + id,
+			Kind:                 sqlite.ConversationKindDirect,
+			NotificationMode:     sqlite.NotificationModeAll,
+			MetadataJSON:         "{}",
+			CreatedAtMS:          nowMS,
+			UpdatedAtMS:          nowMS,
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	legacy, err := db.New(":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = legacy.Close() })
+	work, err := legacy.CreateTab("Work")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var calls []string
+	reads := v2read.New(v2)
+	handler := APIHandlerWithOptions(legacy, nil, zerolog.Nop(), nil, APIOptions{
+		Reads:     reads,
+		V2Primary: true,
+		SetGoogleArchived: func(remoteID string, archived bool) error {
+			calls = append(calls, fmt.Sprintf("%s=%v", remoteID, archived))
+			if remoteID == "remote-conv-refused" {
+				return errors.New("phone said no")
+			}
+			return nil
+		},
+	})
+	do := func(path, body string) *httptest.ResponseRecorder {
+		t.Helper()
+		req := httptest.NewRequest(http.MethodPost, "http://127.0.0.1"+path, strings.NewReader(body))
+		req.Header.Set("Origin", "http://127.0.0.1")
+		req.Header.Set("Content-Type", "application/json")
+		resp := httptest.NewRecorder()
+		handler.ServeHTTP(resp, req)
+		return resp
+	}
+	tabOf := func(id string) string {
+		t.Helper()
+		convo, err := reads.GetConversation(id)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return convo.Tab
+	}
+	expectCalls := func(step string, want ...string) {
+		t.Helper()
+		if strings.Join(calls, ",") != strings.Join(want, ",") {
+			t.Errorf("%s: phone calls = %v, want %v", step, calls, want)
+		}
+		calls = nil
+	}
+
+	if resp := do("/api/conversations/conv-a/tab", `{"tab":"archive"}`); resp.Code != http.StatusOK || tabOf("conv-a") != db.TabArchive {
+		t.Fatalf("archive: status = %d tab = %q; body=%s", resp.Code, tabOf("conv-a"), resp.Body.String())
+	}
+	expectCalls("archive", "remote-conv-a=true")
+
+	if resp := do("/api/conversations/conv-a/tab", `{"tab":"archive"}`); resp.Code != http.StatusOK {
+		t.Fatalf("re-archive: status = %d", resp.Code)
+	}
+	expectCalls("re-archive keeps the phone as it is")
+
+	if resp := do("/api/conversations/conv-a/tab", `{"tab":"`+work.TabID+`"}`); resp.Code != http.StatusOK || tabOf("conv-a") != work.TabID {
+		t.Fatalf("archive -> custom tab: status = %d tab = %q", resp.Code, tabOf("conv-a"))
+	}
+	expectCalls("leaving Archive for a custom tab unarchives", "remote-conv-a=false")
+
+	if resp := do("/api/conversations/conv-b/tab", `{"tab":"`+work.TabID+`"}`); resp.Code != http.StatusOK {
+		t.Fatalf("recent -> custom tab: status = %d", resp.Code)
+	}
+	expectCalls("a custom tab never archives on the phone")
+
+	do("/api/conversations/conv-c/tab", `{"tab":"archive"}`)
+	calls = nil
+	if resp := do("/api/conversations/conv-c/tab", `{"tab":""}`); resp.Code != http.StatusOK || tabOf("conv-c") != "" {
+		t.Fatalf("unarchive: status = %d tab = %q", resp.Code, tabOf("conv-c"))
+	}
+	expectCalls("unarchive", "remote-conv-c=false")
+
+	if resp := do("/api/conversations/conv-signal/tab", `{"tab":"archive"}`); resp.Code != http.StatusOK || tabOf("conv-signal") != db.TabArchive {
+		t.Fatalf("signal archive: status = %d", resp.Code)
+	}
+	expectCalls("signal threads stay local")
+
+	if resp := do("/api/conversations/conv-refused/tab", `{"tab":"archive"}`); resp.Code != http.StatusBadGateway {
+		t.Fatalf("refused archive: status = %d, want 502", resp.Code)
+	}
+	if tab := tabOf("conv-refused"); tab != "" {
+		t.Fatalf("refused archive moved the thread to %q locally", tab)
+	}
+	expectCalls("refused", "remote-conv-refused=true")
+
+	resp := do("/api/conversations/move", `{"ids":["conv-b","conv-refused"],"tab":"archive"}`)
+	var bulk struct {
+		Moved int    `json:"moved"`
+		Error string `json:"error"`
+	}
+	if err := json.Unmarshal(resp.Body.Bytes(), &bulk); err != nil || resp.Code != http.StatusOK {
+		t.Fatalf("bulk: status = %d body = %s", resp.Code, resp.Body.String())
+	}
+	if bulk.Moved != 1 || bulk.Error == "" || tabOf("conv-b") != db.TabArchive || tabOf("conv-refused") != "" {
+		t.Fatalf("bulk answered %+v; conv-b %q conv-refused %q", bulk, tabOf("conv-b"), tabOf("conv-refused"))
+	}
+	expectCalls("bulk", "remote-conv-b=true", "remote-conv-refused=true")
+}
