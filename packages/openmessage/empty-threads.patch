+package app
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/rs/zerolog"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+)
+
+type updatingGMClient struct {
+	*mockGMClient
+	requests []*gmproto.UpdateConversationRequest
+	resp     *gmproto.UpdateConversationResponse
+	err      error
+}
+
+func (u *updatingGMClient) UpdateConversation(req *gmproto.UpdateConversationRequest) (*gmproto.UpdateConversationResponse, error) {
+	u.requests = append(u.requests, req)
+	return u.resp, u.err
+}
+
+func TestSetGoogleConversationArchived(t *testing.T) {
+	gm := &updatingGMClient{mockGMClient: &mockGMClient{}, resp: &gmproto.UpdateConversationResponse{Success: true}}
+	a := &App{Logger: zerolog.Nop(), gmClient: gm}
+
+	for _, archived := range []bool{true, false} {
+		if err := a.SetGoogleConversationArchived("1189", archived); err != nil {
+			t.Fatalf("SetGoogleConversationArchived(1189, %v): %v", archived, err)
+		}
+	}
+	want := []gmproto.ConversationStatus{gmproto.ConversationStatus_ARCHIVED, gmproto.ConversationStatus_ACTIVE}
+	if len(gm.requests) != len(want) {
+		t.Fatalf("sent %d updates, want %d", len(gm.requests), len(want))
+	}
+	for i, req := range gm.requests {
+		data := req.GetUpdateData()
+		if req.GetConversationID() != "1189" || data.GetConversationID() != "1189" || data.GetStatus() != want[i] {
+			t.Errorf("update %d = %v, want conversation 1189 status %s", i, req, want[i])
+		}
+	}
+
+	gm.resp = &gmproto.UpdateConversationResponse{}
+	if err := a.SetGoogleConversationArchived("1189", true); !errors.Is(err, ErrPhoneRejectedUpdate) {
+		t.Errorf("unsuccessful answer = %v, want ErrPhoneRejectedUpdate", err)
+	}
+	failure := errors.New("timed out")
+	gm.resp, gm.err = nil, failure
+	if err := a.SetGoogleConversationArchived("1189", true); !errors.Is(err, failure) {
+		t.Errorf("failed call = %v, want it wrapped", err)
+	}
+
+	plain := &App{Logger: zerolog.Nop(), gmClient: &mockGMClient{}}
+	if err := plain.SetGoogleConversationArchived("1189", true); err == nil {
+		t.Error("a client without conversation updates reported success")
+	}
+}
