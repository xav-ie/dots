+// googleConversationFolder maps a Google thread status to its folder. Google
+// Messages lists spam, blocked and cross-country threads together under Spam
+// & blocked; an unknown status says nothing about the folder.
+func googleConversationFolder(status gmproto.ConversationStatus) string {
+	switch status {
+	case gmproto.ConversationStatus_UNKNOWN_CONVERSATION_STATUS:
+		return ""
+	case gmproto.ConversationStatus_SPAM_FOLDER,
+		gmproto.ConversationStatus_BLOCKED_FOLDER,
+		gmproto.ConversationStatus_CROSS_COUNTRY_FOLDER:
+		return bridge.ConversationFolderSpam
+	default:
+		return bridge.ConversationFolderInbox
+	}
+}
