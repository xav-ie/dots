+package sqlite
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestWithConversationFolder(t *testing.T) {
+	for _, tc := range []struct {
+		metadata, folder, want string
+		changed                bool
+	}{
+		{"{}", "spam", `{"folder":"spam"}`, true},
+		{"", "spam", `{"folder":"spam"}`, true},
+		{`{"other":1}`, "spam", `{"folder":"spam","other":1}`, true},
+		{`{"folder":"spam"}`, "spam", `{"folder":"spam"}`, false},
+		{`{"folder":"spam","other":1}`, "inbox", `{"other":1}`, true},
+		{"{}", "inbox", "{}", false},
+		{`{"folder":"spam"}`, "", `{"folder":"spam"}`, false},
+	} {
+		got, changed, err := WithConversationFolder(tc.metadata, tc.folder)
+		if err != nil || got != tc.want || changed != tc.changed {
+			t.Errorf("WithConversationFolder(%q, %q) = %q, %v, %v; want %q, %v",
+				tc.metadata, tc.folder, got, changed, err, tc.want, tc.changed)
+		}
+		if folder := ConversationFolder(got); (folder == "spam") != strings.Contains(tc.want, "spam") {
+			t.Errorf("ConversationFolder(%q) = %q", got, folder)
+		}
+	}
+	if _, _, err := WithConversationFolder("not json", "spam"); err == nil {
+		t.Error("invalid metadata: want an error")
+	}
+}
