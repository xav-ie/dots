+++ b/internal/storage/sqlite/conversation_folder.go
@@ -0,0 +1,58 @@
+package sqlite
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+// conversationFolderKey holds, in a conversation's metadata_json, the folder
+// its transport files it under when that is not the inbox: "spam" for spam
+// and blocked threads. The key is absent for inbox threads.
+const conversationFolderKey = "folder"
+
+// ConversationFolder returns the folder stored in a conversation's
+// metadata_json, or "" for the inbox.
+func ConversationFolder(metadataJSON string) string {
+	var metadata map[string]any
+	if json.Unmarshal([]byte(metadataJSON), &metadata) != nil {
+		return ""
+	}
+	folder, _ := metadata[conversationFolderKey].(string)
+	return folder
+}
+
+// WithConversationFolder returns metadataJSON with its folder set to folder
+// ("inbox" removes it, "" leaves metadataJSON as is), and whether it changed.
+func WithConversationFolder(metadataJSON, folder string) (string, bool, error) {
+	folder = strings.TrimSpace(folder)
+	if folder == "" {
+		return metadataJSON, false, nil
+	}
+	metadata := map[string]any{}
+	if strings.TrimSpace(metadataJSON) != "" {
+		if err := json.Unmarshal([]byte(metadataJSON), &metadata); err != nil {
+			return "", false, fmt.Errorf("conversation metadata: %w", err)
+		}
+		if metadata == nil {
+			metadata = map[string]any{}
+		}
+	}
+	current, _ := metadata[conversationFolderKey].(string)
+	if folder == "inbox" {
+		folder = ""
+	}
+	if current == folder {
+		return metadataJSON, false, nil
+	}
+	if folder == "" {
+		delete(metadata, conversationFolderKey)
+	} else {
+		metadata[conversationFolderKey] = folder
+	}
+	encoded, err := json.Marshal(metadata)
+	if err != nil {
+		return "", false, fmt.Errorf("conversation metadata: %w", err)
+	}
+	return string(encoded), true, nil
+}
