+package ingest
+
+import (
+	"testing"
+
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+
+	"github.com/maxghenis/openmessage/internal/bridge"
+	"github.com/maxghenis/openmessage/internal/storage/sqlite"
+)
+
+func TestGoogleConversationFolder(t *testing.T) {
+	for status, want := range map[gmproto.ConversationStatus]string{
+		gmproto.ConversationStatus_UNKNOWN_CONVERSATION_STATUS: "",
+		gmproto.ConversationStatus_ACTIVE:                      bridge.ConversationFolderInbox,
+		gmproto.ConversationStatus_ARCHIVED:                    bridge.ConversationFolderInbox,
+		gmproto.ConversationStatus_SPAM_FOLDER:                 bridge.ConversationFolderSpam,
+		gmproto.ConversationStatus_BLOCKED_FOLDER:              bridge.ConversationFolderSpam,
+		gmproto.ConversationStatus_CROSS_COUNTRY_FOLDER:        bridge.ConversationFolderSpam,
+	} {
+		if got := googleConversationFolder(status); got != want {
+			t.Errorf("googleConversationFolder(%v) = %q, want %q", status, got, want)
+		}
+	}
+}
+
+// Live snapshots file a thread into and out of spam; a history snapshot of a
+// thread v2 already holds restamps its folder (how a Spam & blocked folder
+// scan reaches existing threads) and one with no status leaves it.
+func TestConversationFolderFollowsGoogleStatus(t *testing.T) {
+	h := newHWTHarness(t, false)
+	folder := func() string {
+		t.Helper()
+		return sqlite.ConversationFolder(h.conversation(t, "hwt-spam").MetadataJSON)
+	}
+	snapshot := func(status gmproto.ConversationStatus) *gmproto.Conversation {
+		conversation := hwtConversation("hwt-spam", "", false, hwtKarl)
+		conversation.Status = status
+		return conversation
+	}
+
+	h.liveConversation(t, snapshot(gmproto.ConversationStatus_ACTIVE))
+	h.pump(t)
+	if got := folder(); got != "" {
+		t.Fatalf("active thread folder = %q, want inbox", got)
+	}
+
+	h.historyConversation(t, snapshot(gmproto.ConversationStatus_BLOCKED_FOLDER))
+	h.pump(t)
+	if got := folder(); got != "spam" {
+		t.Fatalf("after blocked history snapshot folder = %q, want spam", got)
+	}
+
+	h.historyConversation(t, snapshot(gmproto.ConversationStatus_UNKNOWN_CONVERSATION_STATUS))
+	h.pump(t)
+	if got := folder(); got != "spam" {
+		t.Fatalf("after status-less history snapshot folder = %q, want spam kept", got)
+	}
+
+	h.liveConversation(t, snapshot(gmproto.ConversationStatus_ACTIVE))
+	h.pump(t)
+	if got := folder(); got != "" {
+		t.Fatalf("after unblock folder = %q, want inbox", got)
+	}
+}
