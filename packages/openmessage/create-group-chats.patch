+// requestedPhoneNumbers normalizes the recipient list of a
+// new-conversation request: trim, strip formatting characters, dedupe
+// preserving order. The plural phone_numbers wins; the singular
+// phone_number is the compatibility fallback.
+func requestedPhoneNumbers(numbers []string, fallback string) []string {
+	raw := numbers
+	if len(raw) == 0 && fallback != "" {
+		raw = []string{fallback}
+	}
+	seen := make(map[string]bool, len(raw))
+	out := make([]string, 0, len(raw))
+	for _, n := range raw {
+		n = strings.Map(func(r rune) rune {
+			switch r {
+			case ' ', '-', '(', ')', '\t':
+				return -1
+			}
+			return r
+		}, n)
+		if n == "" || seen[n] {
+			continue
+		}
+		seen[n] = true
+		out = append(out, n)
+	}
+	return out
+}
+
+// googleConversationDisplayName picks the sidebar name for a conversation
+// Google just created: its server-side name, else the non-me participant
+// names (a fresh MMS group is named from its roster), else the raw numbers.
+func googleConversationDisplayName(conv *gmproto.Conversation, phones []string) string {
+	if name := strings.TrimSpace(conv.GetName()); name != "" {
+		return name
+	}
+	var names []string
+	for _, p := range conv.GetParticipants() {
+		if p.GetIsMe() {
+			continue
+		}
+		if cn := strings.TrimSpace(p.GetFullName()); cn != "" {
+			names = append(names, cn)
+			continue
+		}
+		if fn := strings.TrimSpace(p.GetFormattedNumber()); fn != "" {
+			names = append(names, fn)
+		}
+	}
+	if len(names) > 0 {
+		return strings.Join(names, ", ")
+	}
+	return strings.Join(phones, ", ")
+}
