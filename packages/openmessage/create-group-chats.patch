+func TestNewConversationGoogleGroup(t *testing.T) {
+	fetched := make(chan string, 4)
+	ts := newTestServerWithOptions(t, APIOptions{
+		CreateGoogleConversation: func(phones []string) (*gmproto.Conversation, error) {
+			if len(phones) != 2 {
+				t.Errorf("create called with %d phones (%v), want 2 after dedupe", len(phones), phones)
+			}
+			return &gmproto.Conversation{
+				ConversationID: "g-77",
+				IsGroupChat:    true,
+				Participants: []*gmproto.Participant{
+					{FullName: "Luke Burger", FormattedNumber: "+14809394073", ID: &gmproto.SmallInfo{Number: "+14809394073"}},
+					{FullName: "Xavier Ruiz", IsMe: true},
+				},
+			}, nil
+		},
+		FetchHistory: func(convoID string) (int, error) {
+			fetched <- convoID
+			return 1, nil
+		},
+	})
+
+	// The two spellings of Luke's number dedupe to one recipient; the
+	// second number has no participant entry in the fake conversation and
+	// must fall back to the raw phone.
+	body := `{"phone_numbers":["+1 (480) 939-4073","+14809394073","+16232036260"],"platform":"sms"}`
+	resp, err := http.Post(ts.server.URL+"/api/new-conversation", "application/json", strings.NewReader(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != 200 {
+		t.Fatalf("expected 200, got %d", resp.StatusCode)
+	}
+	var got struct {
+		ConversationID string `json:"conversation_id"`
+		Name           string `json:"name"`
+		IsGroup        bool   `json:"is_group"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ConversationID != "g-77" {
+		t.Errorf("conversation_id = %q", got.ConversationID)
+	}
+	if got.Name != "Luke Burger" {
+		t.Errorf("name = %q", got.Name)
+	}
+	if !got.IsGroup {
+		t.Errorf("is_group = false")
+	}
+
+	row, err := ts.store.GetConversation("g-77")
+	if err != nil || row == nil {
+		t.Fatalf("conversation not stored: %v", err)
+	}
+	if !row.IsGroup {
+		t.Errorf("stored row IsGroup = false")
+	}
+	if !strings.Contains(row.Participants, "Luke Burger") || !strings.Contains(row.Participants, "+16232036260") {
+		t.Errorf("participants = %q", row.Participants)
+	}
+	if row.SourcePlatform != "sms" {
+		t.Errorf("source_platform = %q", row.SourcePlatform)
+	}
+
+	// The post-create history fetch is fire-and-forget; it must fire.
+	select {
+	case id := <-fetched:
+		if id != "g-77" {
+			t.Errorf("FetchHistory called for %q", id)
+		}
+	case <-time.After(2 * time.Second):
+		t.Errorf("FetchHistory never called")
+	}
+}
