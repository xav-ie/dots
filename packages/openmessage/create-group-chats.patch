@@ -153,6 +153,47 @@ func TestHistoryKindMismatchOnMessageMintedThreadHealsInPlace(t *testing.T) {
 	}
 }
 
+// An app-created group's first frame is the user's own outgoing "created
+// group" message, which mints a thread with an empty roster — no one has
+// spoken yet. The first snapshot still heals it in place: with no stored
+// peers to contradict, the snapshot is pure information.
+func TestHistoryKindMismatchOnEmptyRosterMintHealsInPlace(t *testing.T) {
+	h := newHWTHarness(t, false)
+	h.liveMessage(t, hwtMessage{id: "hp-empty-0", conversation: "hp-empty", body: "You created this group", at: hwtStart.Add(-2 * time.Hour)}.proto())
+	h.pump(t)
+	minted := h.conversation(t, "hp-empty")
+	if got := minted.Kind; got != "direct" {
+		t.Fatalf("fixture: empty-roster mint kind = %q, want direct", got)
+	}
+	if peers := h.peers(t, minted.ConversationID); len(peers) != 0 {
+		t.Fatalf("fixture: empty-roster mint peers = %v", peers)
+	}
+
+	group := hwtConversation("hp-empty", "Weekend", true, hwtKarl, hwtShoshana)
+	h.historyMessage(t, group, hwtMessage{id: "hp-empty-1", conversation: "hp-empty", body: "fetched", from: hwtShoshana, at: hwtStart.Add(-time.Hour)}.proto())
+	h.pump(t)
+	if counts := h.counts(); counts.HistoryImported != 1 || counts.HistorySkipped != 0 || counts.RemoteRebinds != 0 {
+		t.Fatalf("counters = %+v, want the message imported into the healed thread without a rebind", counts)
+	}
+
+	healed := h.conversation(t, "hp-empty")
+	if healed.ConversationID != minted.ConversationID {
+		t.Fatalf("healed thread = %s, want the minted row %s kept", healed.ConversationID, minted.ConversationID)
+	}
+	if healed.Kind != "group" || healed.Title != "Weekend" {
+		t.Fatalf("healed thread kind = %q title = %q, want group \"Weekend\"", healed.Kind, healed.Title)
+	}
+	if sqlite.ConversationMintSource(healed.MetadataJSON) != "" {
+		t.Fatalf("mint marker survived the snapshot refresh")
+	}
+	if peers := h.peers(t, healed.ConversationID); !slices.Equal(peers, []string{hwtKarl, hwtShoshana}) {
+		t.Fatalf("healed roster = %v, want [%s %s]", peers, hwtKarl, hwtShoshana)
+	}
+	if got := h.message(t, "hp-empty", "hp-empty-1").Body; got != "fetched" {
+		t.Fatalf("imported body = %q", got)
+	}
+}
