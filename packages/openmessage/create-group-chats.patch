+// googleConversationRow builds the local display row for a conversation
+// Google just created — single or MMS group.
+func googleConversationRow(convoID, name string, conv *gmproto.Conversation, phones []string) *db.Conversation {
+	row := &db.Conversation{
+		ConversationID: convoID,
+		Name:           name,
+		IsGroup:        conv.GetIsGroupChat(),
+		LastMessageTS:  time.Now().UnixMilli(),
+		SourcePlatform: "sms",
+	}
+	type participantJSON struct {
+		Name   string `json:"name"`
+		Number string `json:"number"`
+		IsMe   bool   `json:"is_me,omitempty"`
+	}
+	known := make(map[string]bool, len(phones))
+	var participants []participantJSON
+	for _, p := range conv.GetParticipants() {
+		if p.GetIsMe() {
+			continue
+		}
+		number := p.GetID().GetNumber()
+		if number == "" {
+			number = p.GetFormattedNumber()
+		}
+		if number != "" {
+			known[number] = true
+		}
+		displayName := p.GetFullName()
+		if displayName == "" {
+			displayName = number
+		}
+		participants = append(participants, participantJSON{Name: displayName, Number: number})
+	}
+	for _, phone := range phones {
+		if !known[phone] {
+			participants = append(participants, participantJSON{Name: phone, Number: phone})
+		}
+	}
+	if len(participants) > 0 {
+		if b, err := json.Marshal(participants); err == nil {
+			row.Participants = string(b)
+		}
+	}
+	return row
+}
