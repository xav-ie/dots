+
+// v2DisplayNameForNumber resolves a phone number to a stored identity's
+// display name, falling back to the number itself — the same match the
+// synthetic importer uses for senders.
+func v2DisplayNameForNumber(v2Store *sqlite.Store, phone string) string {
+	identities, err := v2Store.ListIdentities("google-primary")
+	if err == nil {
+		for _, identity := range identities {
+			if identity.CanonicalValue == phone || identity.RawValue == phone {
+				if identity.DisplayName != "" {
+					return identity.DisplayName
+				}
+				return phone
+			}
+		}
+	}
+	return phone
+}
+
+// ensureE2EIdentity returns the identity id for a phone number, minting a
+// minimal e164 identity when the fixture never had one.
+func ensureE2EIdentity(v2Store *sqlite.Store, accountID, phone, name string) (string, error) {
+	identity, err := v2Store.GetIdentityByCanonical(accountID, sqlite.IdentityKind("e164"), phone)
+	if err == nil {
+		return identity.IdentityID, nil
+	}
+	now := time.Now().UnixMilli()
+	identity = sqlite.Identity{
+		IdentityID:     v2keys.DeriveID("identity", accountID, "e164\x1f"+phone),
+		AccountID:      accountID,
+		Kind:           sqlite.IdentityKind("e164"),
+		CanonicalValue: phone,
+		RawValue:       phone,
+		DisplayName:    name,
+		MetadataJSON:   "{}",
+		CreatedAtMS:    now,
+		UpdatedAtMS:    now,
+	}
+	if err := v2Store.UpsertIdentity(identity); err != nil {
+		return "", err
+	}
+	return identity.IdentityID, nil
+}
+
+// materializeE2EGroup builds the v2 thread the real ingest would mint from a
+// history snapshot of a newly created group: a group-kind conversation under
+// the remote id, the full roster, and the outgoing "created this group"
+// system message.
+func materializeE2EGroup(v2Store *sqlite.Store, events *web.EventBroker, remoteID string, phones []string) error {
+	accountID := "google-primary"
+	conversationID := v2keys.DeriveID("conversation", accountID, remoteID)
+	now := time.Now().UnixMilli()
+	names := make([]string, 0, len(phones))
+	for _, phone := range phones {
+		names = append(names, v2DisplayNameForNumber(v2Store, phone))
+	}
+	if err := v2Store.UpsertConversation(sqlite.Conversation{
+		ConversationID:       conversationID,
+		AccountID:            accountID,
+		RemoteConversationID: remoteID,
+		Kind:                 sqlite.ConversationKindGroup,
+		Title:                strings.Join(names, ", "),
+		NotificationMode:     sqlite.NotificationModeAll,
+		LastMessageAtMS:      now,
+		MetadataJSON:         "{}",
+		CreatedAtMS:          now,
+		UpdatedAtMS:          now,
+	}); err != nil {
+		return fmt.Errorf("upsert e2e group conversation: %w", err)
+	}
+	roster := make([]string, 0, len(phones)+1)
+	for i, phone := range phones {
+		identityID, err := ensureE2EIdentity(v2Store, accountID, phone, names[i])
+		if err != nil {
+			return fmt.Errorf("ensure identity for %q: %w", phone, err)
+		}
+		roster = append(roster, identityID)
+	}
+	identities, err := v2Store.ListIdentities(accountID)
+	if err != nil {
+		return fmt.Errorf("list identities: %w", err)
+	}
+	for _, identity := range identities {
+		if identity.IsSelf {
+			roster = append(roster, identity.IdentityID)
+			break
+		}
+	}
+	for _, identityID := range roster {
+		if _, err := v2Store.EnsureConversationParticipant(sqlite.ConversationParticipant{
+			AccountID:      accountID,
+			ConversationID: conversationID,
+			IdentityID:     identityID,
+			Role:           sqlite.ParticipantRoleMember,
+			IsActive:       true,
+		}); err != nil {
+			return fmt.Errorf("ensure participant: %w", err)
+		}
+	}
+	repository, err := sqlite.NewMessageRepository(v2Store, time.Now)
+	if err != nil {
+		return err
+	}
+	remoteMessageID := remoteID + "-created"
+	if err := repository.ImportMessage(context.Background(), sqlite.MessageProjection{Message: sqlite.Message{
+		MessageID:      v2keys.DeriveID("message", accountID, remoteID+"\x1f"+remoteMessageID),
+		ConversationID: conversationID,
+		AccountID:      accountID,
+		RemoteMessageID: remoteMessageID,
+		Direction:      sqlite.MessageDirectionOutgoing,
+		Body:           "You created this group MMS with " + strings.Join(names, " and "),
+		State:          sqlite.MessageStateActive,
+		OccurredAtMS:   now,
+	}}); err != nil {
+		return fmt.Errorf("import e2e group creation message: %w", err)
+	}
+	events.PublishConversations()
+	events.PublishMessages(conversationID)
+	return nil
+}
