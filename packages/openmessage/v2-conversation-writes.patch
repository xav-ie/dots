+	"github.com/maxghenis/openmessage/internal/v2read"
+)
+
+func TestConversationPreferenceRoutesWriteV2(t *testing.T) {
+	v2, err := sqlite.Open(filepath.Join(t.TempDir(), "v2.sqlite3"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = v2.Close() })
+	nowMS := time.Now().UnixMilli()
+	if err := v2.UpsertAccount(sqlite.Account{
+		AccountID:   "google-primary",
+		BridgeKey:   "google_messages",
+		DisplayName: "Google",
+		Mode:        sqlite.AccountModeLive,
+		Enabled:     true,
+		ConfigJSON:  "{}",
+		CreatedAtMS: nowMS,
+		UpdatedAtMS: nowMS,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := v2.UpsertConversation(sqlite.Conversation{
+		ConversationID:       "conv-a",
+		AccountID:            "google-primary",
+		RemoteConversationID: "remote-a",
+		Kind:                 sqlite.ConversationKindDirect,
+		NotificationMode:     sqlite.NotificationModeAll,
+		MetadataJSON:         "{}",
+		CreatedAtMS:          nowMS,
+		UpdatedAtMS:          nowMS,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	legacy, err := db.New(":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = legacy.Close() })
+	handler := APIHandlerWithOptions(legacy, nil, zerolog.Nop(), nil, APIOptions{
+		Reads:     v2read.New(v2),
+		V2Primary: true,
+	})
+	do := func(path, body string) *httptest.ResponseRecorder {
+		t.Helper()
+		req := httptest.NewRequest(http.MethodPost, "http://127.0.0.1"+path, strings.NewReader(body))
+		req.Header.Set("Origin", "http://127.0.0.1")
+		req.Header.Set("Content-Type", "application/json")
+		resp := httptest.NewRecorder()
+		handler.ServeHTTP(resp, req)
+		return resp
+	}
+	decode := func(resp *httptest.ResponseRecorder) db.Conversation {
+		t.Helper()
+		var convo db.Conversation
+		if err := json.Unmarshal(resp.Body.Bytes(), &convo); err != nil {
+			t.Fatalf("decode %s: %v", resp.Body.String(), err)
+		}
+		return convo
+	}
+
+	resp := do("/api/conversations/conv-a/favorite", `{"favorite":true}`)
+	if resp.Code != http.StatusOK {
+		t.Fatalf("favorite: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+	if convo := decode(resp); convo.ConversationID != "conv-a" || !convo.IsFavorite {
+		t.Fatalf("favorite response = %+v", convo)
+	}
+
+	resp = do("/api/conversations/conv-a/notification-mode", `{"notification_mode":"Muted"}`)
+	if resp.Code != http.StatusOK {
+		t.Fatalf("mute: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+	if convo := decode(resp); convo.NotificationMode != "muted" || !convo.IsFavorite {
+		t.Fatalf("mute response = %+v", convo)
+	}
+
+	// The legacy remote ID resolves to the same v2 conversation.
+	resp = do("/api/conversations/remote-a/favorite", `{"favorite":false}`)
+	if resp.Code != http.StatusOK {
+		t.Fatalf("unfavorite by remote id: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+	stored, err := v2.GetConversation("conv-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stored.IsFavorite || stored.NotificationMode != sqlite.NotificationModeMuted {
+		t.Fatalf("stored favorite = %v, mode = %q", stored.IsFavorite, stored.NotificationMode)
+	}
+
+	if resp := do("/api/conversations/conv-a/notification-mode", `{"notification_mode":"loud"}`); resp.Code != http.StatusBadRequest {
+		t.Fatalf("invalid mode: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+	if resp := do("/api/conversations/missing/favorite", `{"favorite":true}`); resp.Code != http.StatusNotFound {
+		t.Fatalf("missing favorite: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+	if resp := do("/api/conversations/missing/notification-mode", `{"notification_mode":"all"}`); resp.Code != http.StatusNotFound {
+		t.Fatalf("missing mode: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+}
