@@ -0,0 +1,56 @@
+package sqlite
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// ErrInvalidNotificationMode rejects a notification mode outside all,
+// mentions and muted.
+var ErrInvalidNotificationMode = errors.New("invalid notification mode")
+
+// ParseNotificationMode normalizes a user-supplied notification mode.
+func ParseNotificationMode(mode string) (NotificationMode, error) {
+	switch normalized := NotificationMode(strings.ToLower(strings.TrimSpace(mode))); normalized {
+	case NotificationModeAll, NotificationModeMentions, NotificationModeMuted:
+		return normalized, nil
+	default:
+		return "", fmt.Errorf("%w %q", ErrInvalidNotificationMode, mode)
+	}
+}
+
+// SetConversationFavorite stores the user's favorite flag for a conversation.
+func (s *Store) SetConversationFavorite(conversationID string, favorite bool, nowMS int64) error {
+	return s.updateConversationPreference(conversationID, "favorite",
+		`UPDATE conversations SET is_favorite = ?, updated_at_ms = MAX(updated_at_ms, ?) WHERE conversation_id = ?`,
+		favorite, nowMS, conversationID)
+}
+
+// SetConversationNotificationMode stores the user's notification mode for a
+// conversation.
+func (s *Store) SetConversationNotificationMode(conversationID string, mode NotificationMode, nowMS int64) error {
+	mode, err := ParseNotificationMode(string(mode))
+	if err != nil {
+		return fmt.Errorf("set conversation %q notification mode: %w", conversationID, err)
+	}
+	return s.updateConversationPreference(conversationID, "notification mode",
+		`UPDATE conversations SET notification_mode = ?, updated_at_ms = MAX(updated_at_ms, ?) WHERE conversation_id = ?`,
+		mode, nowMS, conversationID)
+}
+
+func (s *Store) updateConversationPreference(conversationID, what, query string, args ...any) error {
+	result, err := s.db.ExecContext(context.Background(), query, args...)
+	if err != nil {
+		return fmt.Errorf("set conversation %q %s: %w", conversationID, what, err)
+	}
+	updated, err := result.RowsAffected()
+	if err != nil {
+		return fmt.Errorf("set conversation %q %s: %w", conversationID, what, err)
+	}
+	if updated == 0 {
+		return fmt.Errorf("set conversation %q %s: %w", conversationID, what, ErrNotFound)
+	}
+	return nil
+}
