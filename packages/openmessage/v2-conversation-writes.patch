+++ b/internal/v2read/preferences.go
@@ -0,0 +1,45 @@
+package v2read
+
+import (
+	"database/sql"
+	"errors"
+
+	"github.com/maxghenis/openmessage/internal/storage/sqlite"
+)
+
+// SetFavorite is the v2 write behind the web UI's favorite
+// toggle: v2 reads never see the legacy store's is_favorite. The id may be a
+// v2 conversation ID or a legacy remote ID.
+func (s *Source) SetFavorite(id string, favorite bool) error {
+	if err := s.ready(); err != nil {
+		return err
+	}
+	return notFoundAsNoRows(s.store.SetConversationFavorite(s.resolveConversationID(id), favorite, s.now().UnixMilli()))
+}
+
+// SetNotificationMode is the v2 write behind the web UI's
+// notification setting (all, mentions or muted).
+func (s *Source) SetNotificationMode(id, mode string) error {
+	if err := s.ready(); err != nil {
+		return err
+	}
+	return notFoundAsNoRows(s.store.SetConversationNotificationMode(
+		s.resolveConversationID(id), sqlite.NotificationMode(mode), s.now().UnixMilli()))
+}
+
+// MarkRead is the v2 write behind the web UI's mark-read: it advances the
+// local read cursor, clearing the thread's unread count. Like the legacy path
+// it doesn't tell the phone.
+func (s *Source) MarkRead(id string) error {
+	if err := s.ready(); err != nil {
+		return err
+	}
+	return notFoundAsNoRows(s.store.MarkConversationReadLocally(s.resolveConversationID(id), s.now().UnixMilli()))
+}
+
+func notFoundAsNoRows(err error) error {
+	if errors.Is(err, sqlite.ErrNotFound) {
+		return sql.ErrNoRows
+	}
+	return err
+}
