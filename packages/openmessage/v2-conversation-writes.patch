+++ b/internal/storage/sqlite/people.go
@@ -0,0 +1,44 @@
+package sqlite
+
+import (
+	"context"
+	"fmt"
+)
+
+// RealMessageCountsByConversation counts content-bearing messages (a body or
+// an attachment, not an RCS/SMS system notice, not deleted) per conversation
+// in one query, like the legacy store's count behind the People list.
+func (s *Store) RealMessageCountsByConversation() (map[string]int, error) {
+	rows, err := s.db.QueryContext(context.Background(), `
+		SELECT m.conversation_id, COUNT(*)
+		FROM messages m
+		WHERE m.state <> 'deleted'
+			AND (TRIM(m.body) <> '' OR EXISTS (
+				SELECT 1 FROM message_attachments a WHERE a.message_id = m.message_id
+			))
+			AND lower(m.body) NOT LIKE 'rcs chat with%'
+			AND lower(m.body) NOT LIKE 'this rcs chat is now%'
+			AND lower(m.body) NOT LIKE 'you created this rcs%'
+			AND lower(m.body) NOT LIKE 'you started an rcs%'
+			AND lower(m.body) NOT LIKE 'this chat is now%'
+			AND lower(m.body) NOT LIKE 'sms/mms with%'
+		GROUP BY m.conversation_id
+	`)
+	if err != nil {
+		return nil, fmt.Errorf("count real messages: %w", err)
+	}
+	defer rows.Close()
+	counts := map[string]int{}
+	for rows.Next() {
+		var id string
+		var count int
+		if err := rows.Scan(&id, &count); err != nil {
+			return nil, fmt.Errorf("count real messages: %w", err)
+		}
+		counts[id] = count
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("count real messages: %w", err)
+	}
+	return counts, nil
+}
diff --git a/internal/storage/sqlite/unread.go b/internal/storage/sqlite/unread.go
new file mode 100644
index 0000000..e3e6075
--- /dev/null
+++ b/internal/storage/sqlite/unread.go
@@ -0,0 +1,99 @@
+package sqlite
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// UnreadCounts returns, for each conversation with any, the number of
+// incoming messages newer than the local installation's read cursor (the same
+// cursor ingest advances when the transport reports the thread read). One
+// aggregate query covers the whole page; conversations absent from the map
+// have none unread. Long lists go in chunks, under SQLite's variable limit.
+func (s *Store) UnreadCounts(conversationIDs []string) (map[string]int, error) {
+	counts := make(map[string]int, len(conversationIDs))
+	for start := 0; start < len(conversationIDs); start += unreadCountChunk {
+		end := min(start+unreadCountChunk, len(conversationIDs))
+		if err := s.addUnreadCounts(conversationIDs[start:end], counts); err != nil {
+			return nil, err
+		}
+	}
+	return counts, nil
+}
+
+// unreadCountChunk bounds the conversation IDs per query; each is bound twice.
+const unreadCountChunk = 500
+
+func (s *Store) addUnreadCounts(conversationIDs []string, counts map[string]int) error {
+	placeholders := strings.TrimSuffix(strings.Repeat("?,", len(conversationIDs)), ",")
+	args := make([]any, 0, 2*len(conversationIDs))
+	for _, id := range conversationIDs {
+		args = append(args, id)
+	}
+	for _, id := range conversationIDs {
+		args = append(args, id)
+	}
+	rows, err := s.db.QueryContext(context.Background(), `
+		WITH cursors AS (
+			SELECT r.conversation_id, MAX(r.last_read_at_ms) AS read_at_ms
+			FROM read_cursors r
+			JOIN devices d ON d.device_id = r.device_id
+				AND d.kind = 'local_installation' AND d.is_current = 1
+			WHERE r.conversation_id IN (`+placeholders+`)
+			GROUP BY r.conversation_id
+		)
+		SELECT m.conversation_id, COUNT(*)
+		FROM messages m
+		LEFT JOIN cursors c ON c.conversation_id = m.conversation_id
+		WHERE m.conversation_id IN (`+placeholders+`)
+			AND m.direction = 'incoming'
+			AND m.state <> 'deleted'
+			AND m.occurred_at_ms > COALESCE(c.read_at_ms, 0)
+		GROUP BY m.conversation_id
+	`, args...)
+	if err != nil {
+		return fmt.Errorf("count unread messages: %w", err)
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var id string
+		var count int
+		if err := rows.Scan(&id, &count); err != nil {
+			return fmt.Errorf("count unread messages: %w", err)
+		}
+		counts[id] = count
+	}
+	if err := rows.Err(); err != nil {
+		return fmt.Errorf("count unread messages: %w", err)
+	}
+	return nil
+}
+
+// MarkConversationReadLocally advances the local installation's read cursor
+// for a conversation to nowMS, clearing its unread count here. It tells no
+// transport; the phone keeps its own read state.
+func (s *Store) MarkConversationReadLocally(conversationID string, nowMS int64) error {
+	conversation, err := s.GetConversation(conversationID)
+	if err != nil {
+		return fmt.Errorf("mark conversation %q read: %w", conversationID, err)
+	}
+	device, err := s.GetLocalInstallationDevice(context.Background(), conversation.AccountID)
+	if errors.Is(err, ErrNotFound) {
+		return fmt.Errorf("mark conversation %q read: account %q has no local device",
+			conversationID, conversation.AccountID)
+	}
+	if err != nil {
+		return fmt.Errorf("mark conversation %q read: %w", conversationID, err)
+	}
+	// Read through the newest message too, in case its clock ran ahead.
+	readAtMS := max(nowMS, conversation.LastMessageAtMS)
+	return s.UpsertReadCursor(ReadCursor{
+		AccountID:      conversation.AccountID,
+		DeviceID:       device.DeviceID,
+		ConversationID: conversation.ConversationID,
+		LastReadAtMS:   readAtMS,
+		UpdatedAtMS:    nowMS,
+	})
+}
