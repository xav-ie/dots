@@ -0,0 +1,38 @@
+package v2read
+
+import (
+	"fmt"
+
+	"github.com/maxghenis/openmessage/internal/db"
+)
+
+// peopleConversationLimit matches the legacy People list's conversation scan.
+const peopleConversationLimit = 5000
+
+// ListMessagedPeople is the v2 People list: everyone with 1:1 history,
+// grouped by name as the legacy store groups them, from v2 conversations (the
+// legacy store froze at cutover).
+func (s *Source) ListMessagedPeople() ([]*db.Person, error) {
+	conversations, err := s.ListConversations(peopleConversationLimit)
+	if err != nil {
+		return nil, fmt.Errorf("list people: %w", err)
+	}
+	counts, err := s.store.RealMessageCountsByConversation()
+	if err != nil {
+		return nil, fmt.Errorf("list people: %w", err)
+	}
+	return db.PeopleFromConversations(conversations, counts), nil
+}
+
+// PersonMessages returns a person's messages across their conversations,
+// chronological, with cross-platform duplicates dropped.
+func (s *Source) PersonMessages(conversationIDs []string) ([]*db.Message, error) {
+	if len(conversationIDs) == 0 {
+		return nil, nil
+	}
+	messages, err := s.GetMessagesByConversations(conversationIDs, 500000)
+	if err != nil {
+		return nil, err
+	}
+	return db.DedupePersonMessages(messages), nil
+}
