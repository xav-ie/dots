+++ b/internal/web/v2_people_test.go
@@ -0,0 +1,110 @@
+package web
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+
+	"github.com/maxghenis/openmessage/internal/db"
+	"github.com/maxghenis/openmessage/internal/storage/sqlite"
+	"github.com/maxghenis/openmessage/internal/v2read"
+)
+
+func TestPeopleRoutesReadV2(t *testing.T) {
+	v2, err := sqlite.Open(filepath.Join(t.TempDir(), "v2.sqlite3"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = v2.Close() })
+	nowMS := time.Now().UnixMilli()
+	for _, account := range []sqlite.Account{
+		{AccountID: "google-primary", BridgeKey: "google_messages", DisplayName: "Google"},
+		{AccountID: "signal-primary", BridgeKey: "signal", DisplayName: "Signal"},
+	} {
+		account.Mode, account.Enabled, account.ConfigJSON = sqlite.AccountModeLive, true, "{}"
+		account.CreatedAtMS, account.UpdatedAtMS = nowMS, nowMS
+		if err := v2.UpsertAccount(account); err != nil {
+			t.Fatal(err)
+		}
+	}
+	conversations := []sqlite.Conversation{
+		{ConversationID: "pat-sms", AccountID: "google-primary", Title: "Pat Doe", Kind: sqlite.ConversationKindDirect, LastMessageAtMS: nowMS - 3000},
+		{ConversationID: "pat-signal", AccountID: "signal-primary", Title: "Pat Doe", Kind: sqlite.ConversationKindDirect, LastMessageAtMS: nowMS - 1000},
+		{ConversationID: "group", AccountID: "google-primary", Title: "Weekend", Kind: sqlite.ConversationKindGroup, LastMessageAtMS: nowMS - 500},
+		{ConversationID: "spammer", AccountID: "google-primary", Title: "Spam Co", Kind: sqlite.ConversationKindDirect, LastMessageAtMS: nowMS - 200, MetadataJSON: `{"folder":"spam"}`},
+	}
+	for _, conversation := range conversations {
+		conversation.RemoteConversationID = "remote-" + conversation.ConversationID
+		conversation.NotificationMode = sqlite.NotificationModeAll
+		if conversation.MetadataJSON == "" {
+			conversation.MetadataJSON = "{}"
+		}
+		conversation.CreatedAtMS, conversation.UpdatedAtMS = nowMS-10000, nowMS-10000
+		if err := v2.UpsertConversation(conversation); err != nil {
+			t.Fatal(err)
+		}
+	}
+	messages, err := sqlite.NewMessageRepository(v2, time.Now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i, m := range []struct{ id, conversation, account, body string }{
+		{"m1", "pat-sms", "google-primary", "hi pat"},
+		{"m2", "pat-sms", "google-primary", "SMS/MMS with Pat Doe"},
+		{"m3", "pat-signal", "signal-primary", "lunch?"},
+		{"m4", "group", "google-primary", "group chat"},
+	} {
+		if _, err := messages.InsertHistoricalMessage(context.Background(), sqlite.MessageProjection{Message: sqlite.Message{
+			MessageID: m.id, ConversationID: m.conversation, AccountID: m.account, RemoteMessageID: m.id,
+			Direction: sqlite.MessageDirectionIncoming, Body: m.body, State: sqlite.MessageStateActive,
+			OccurredAtMS: nowMS - 5000 + int64(i), CreatedAtMS: nowMS, UpdatedAtMS: nowMS,
+		}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	legacy, err := db.New(":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = legacy.Close() })
+	handler := APIHandlerWithOptions(legacy, nil, zerolog.Nop(), nil, APIOptions{
+		Reads:     v2read.New(v2),
+		V2Primary: true,
+	})
+	get := func(path string, out any) {
+		t.Helper()
+		req := httptest.NewRequest(http.MethodGet, "http://127.0.0.1"+path, nil)
+		req.Header.Set("Origin", "http://127.0.0.1")
+		resp := httptest.NewRecorder()
+		handler.ServeHTTP(resp, req)
+		if resp.Code != http.StatusOK {
+			t.Fatalf("GET %s: status = %d; body=%s", path, resp.Code, resp.Body.String())
+		}
+		if err := json.Unmarshal(resp.Body.Bytes(), out); err != nil {
+			t.Fatalf("GET %s: %v", path, err)
+		}
+	}
+
+	var people []personPayload
+	get("/api/people", &people)
+	if len(people) != 1 {
+		t.Fatalf("people = %+v, want only Pat (groups and spam aren't people)", people)
+	}
+	pat := people[0]
+	if pat.Name != "Pat Doe" || pat.MessageCount != 2 || len(pat.Platforms) != 2 || pat.LastContactedTS != nowMS-1000 {
+		t.Fatalf("Pat = %+v, want 2 real messages across sms and signal, last contacted on Signal", pat)
+	}
+
+	var detail personPayload
+	get("/api/people/"+url.PathEscape(pat.Key), &detail)
+	if detail.Name != "Pat Doe" || detail.MessageCount != 2 || len(detail.ConversationIDs) != 2 {
+		t.Fatalf("detail = %+v", detail)
+	}
+}
