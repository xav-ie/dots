+func TestMarkReadWritesV2Cursor(t *testing.T) {
+	v2, err := sqlite.Open(filepath.Join(t.TempDir(), "v2.sqlite3"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = v2.Close() })
+	nowMS := time.Now().UnixMilli()
+	if err := v2.UpsertAccount(sqlite.Account{
+		AccountID: "google-primary", BridgeKey: "google_messages", DisplayName: "Google",
+		Mode: sqlite.AccountModeLive, Enabled: true, ConfigJSON: "{}", CreatedAtMS: nowMS, UpdatedAtMS: nowMS,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := v2.UpsertDevice(sqlite.Device{
+		DeviceID: "local", AccountID: "google-primary", Kind: sqlite.DeviceKindLocalInstallation,
+		State: "active", IsCurrent: true, CreatedAtMS: nowMS, UpdatedAtMS: nowMS,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := v2.UpsertConversation(sqlite.Conversation{
+		ConversationID: "conv-a", AccountID: "google-primary", RemoteConversationID: "remote-a",
+		Kind: sqlite.ConversationKindDirect, NotificationMode: sqlite.NotificationModeAll, MetadataJSON: "{}",
+		LastMessageAtMS: nowMS - 1000, CreatedAtMS: nowMS - 5000, UpdatedAtMS: nowMS - 5000,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	messages, err := sqlite.NewMessageRepository(v2, time.Now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i, direction := range []sqlite.MessageDirection{sqlite.MessageDirectionIncoming, sqlite.MessageDirectionIncoming} {
+		id := "m" + string(rune('1'+i))
+		if _, err := messages.InsertHistoricalMessage(context.Background(), sqlite.MessageProjection{Message: sqlite.Message{
+			MessageID: id, ConversationID: "conv-a", AccountID: "google-primary", RemoteMessageID: id,
+			Direction: direction, State: sqlite.MessageStateActive,
+			OccurredAtMS: nowMS - 2000 + int64(i), CreatedAtMS: nowMS, UpdatedAtMS: nowMS,
+		}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	legacy, err := db.New(":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = legacy.Close() })
+	handler := APIHandlerWithOptions(legacy, nil, zerolog.Nop(), nil, APIOptions{
+		Reads:     v2read.New(v2),
+		V2Primary: true,
+	})
+	do := func(method, path, body string) *httptest.ResponseRecorder {
+		t.Helper()
+		req := httptest.NewRequest(method, "http://127.0.0.1"+path, strings.NewReader(body))
+		req.Header.Set("Origin", "http://127.0.0.1")
+		req.Header.Set("Content-Type", "application/json")
+		resp := httptest.NewRecorder()
+		handler.ServeHTTP(resp, req)
+		return resp
+	}
+	unread := func() int {
+		t.Helper()
+		resp := do(http.MethodGet, "/api/conversations?limit=10", "")
+		var list []db.Conversation
+		if err := json.Unmarshal(resp.Body.Bytes(), &list); err != nil || len(list) != 1 {
+			t.Fatalf("list: %v %s", err, resp.Body.String())
+		}
+		return list[0].UnreadCount
+	}
+
+	if got := unread(); got != 2 {
+		t.Fatalf("unread before mark-read = %d, want 2", got)
+	}
+	if resp := do(http.MethodPost, "/api/mark-read", `{"conversation_id":"conv-a"}`); resp.Code != http.StatusOK {
+		t.Fatalf("mark-read: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+	if got := unread(); got != 0 {
+		t.Fatalf("unread after mark-read = %d, want 0", got)
+	}
+	if resp := do(http.MethodPost, "/api/mark-read", `{"conversation_id":"missing"}`); resp.Code != http.StatusNotFound {
+		t.Fatalf("mark-read missing: status = %d; body=%s", resp.Code, resp.Body.String())
+	}
+}
