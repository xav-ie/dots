@@ -0,0 +1,92 @@
+package sqlite
+
+import (
+	"errors"
+	"path/filepath"
+	"testing"
+)
+
+func TestUnreadCountsFollowLocalReadCursor(t *testing.T) {
+	store, err := Open(filepath.Join(t.TempDir(), "v2.sqlite3"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = store.Close() })
+	const nowMS = int64(1_800_000_000_000)
+	if err := store.UpsertAccount(Account{
+		AccountID: "google-primary", BridgeKey: "google_messages", DisplayName: "Google",
+		Mode: AccountModeLive, Enabled: true, ConfigJSON: "{}", CreatedAtMS: nowMS, UpdatedAtMS: nowMS,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	for _, device := range []Device{
+		{DeviceID: "local", AccountID: "google-primary", Kind: DeviceKindLocalInstallation, State: "active", IsCurrent: true, CreatedAtMS: nowMS, UpdatedAtMS: nowMS},
+		{DeviceID: "phone", AccountID: "google-primary", Kind: "remote_endpoint", State: "active", CreatedAtMS: nowMS, UpdatedAtMS: nowMS},
+	} {
+		if err := store.UpsertDevice(device); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, id := range []string{"conv-a", "conv-b", "conv-c"} {
+		if err := store.UpsertConversation(Conversation{
+			ConversationID: id, AccountID: "google-primary", RemoteConversationID: "remote-" + id,
+			Kind: ConversationKindDirect, NotificationMode: NotificationModeAll, MetadataJSON: "{}",
+			LastMessageAtMS: nowMS + 40, CreatedAtMS: nowMS, UpdatedAtMS: nowMS,
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	insert := func(id, conversation, direction, state string, atMS int64) {
+		t.Helper()
+		if _, err := store.db.Exec(`
+			INSERT INTO messages (message_id, conversation_id, account_id, remote_message_id, direction, state, occurred_at_ms, created_at_ms, updated_at_ms)
+			VALUES (?, ?, 'google-primary', ?, ?, ?, ?, ?, ?)`,
+			id, conversation, id, direction, state, atMS, atMS, atMS); err != nil {
+			t.Fatal(err)
+		}
+	}
+	insert("a1", "conv-a", "incoming", "active", nowMS+10)
+	insert("a2", "conv-a", "outgoing", "active", nowMS+20)
+	insert("a3", "conv-a", "incoming", "active", nowMS+30)
+	insert("a4", "conv-a", "incoming", "deleted", nowMS+35)
+	insert("a5", "conv-a", "incoming", "active", nowMS+40)
+	insert("b1", "conv-b", "incoming", "active", nowMS+10)
+	cursor := func(device, conversation string, atMS int64) {
+		t.Helper()
+		if err := store.UpsertReadCursor(ReadCursor{
+			AccountID: "google-primary", DeviceID: device, ConversationID: conversation,
+			LastReadAtMS: atMS, UpdatedAtMS: nowMS,
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// Read through a1 locally; a phone-endpoint cursor doesn't count.
+	cursor("local", "conv-a", nowMS+10)
+	cursor("phone", "conv-b", nowMS+50)
+
+	counts, err := store.UnreadCounts([]string{"conv-a", "conv-b", "conv-c"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if counts["conv-a"] != 2 || counts["conv-b"] != 1 || counts["conv-c"] != 0 {
+		t.Fatalf("unread = %v, want conv-a 2 (a3, a5), conv-b 1, conv-c 0", counts)
+	}
+	if empty, err := store.UnreadCounts(nil); err != nil || len(empty) != 0 {
+		t.Fatalf("UnreadCounts(nil) = %v, %v", empty, err)
+	}
+
+	if err := store.MarkConversationReadLocally("conv-a", nowMS); err != nil {
+		t.Fatal(err)
+	}
+	counts, err = store.UnreadCounts([]string{"conv-a", "conv-b"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The cursor reads through the newest message even though "now" is older.
+	if counts["conv-a"] != 0 || counts["conv-b"] != 1 {
+		t.Fatalf("after mark read: unread = %v, want conv-a 0, conv-b 1", counts)
+	}
+	if err := store.MarkConversationReadLocally("missing", nowMS); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("missing conversation: err = %v, want ErrNotFound", err)
+	}
+}
