+test('opens a thread with unread messages at a New messages divider', async ({ page, request }) => {
+  // Read the whole paged thread first so its cursor sits at the newest
+  // message, then leave it and let a new message arrive.
+  await openConversation(page, 'Paged Thread');
+  await expect(page.locator('#messages-area .msg')).toHaveCount(100);
+  await openConversation(page, 'Sarah Chen');
+  await expect(page.locator('#messages-area .msg').first()).toBeVisible();
+
+  const unreadBefore = await titleUnreadTotal(page);
+  await request.post('/_e2e/messages', {
+    data: {
+      body: 'Unread anchor arrival',
+      conversation_id: 'conv-paged',
+      is_from_me: false,
+      sender_name: 'Pat Page',
+      sender_number: '+15550001111',
+    },
+  });
+
+  const pagedRow = page.locator('#conversation-list .convo-item').filter({ hasText: 'Paged Thread' });
+  await expect(pagedRow.locator('.convo-unread')).toHaveText('1');
+  await expect.poll(() => titleUnreadTotal(page)).toBe(unreadBefore + 1);
+
+  await pagedRow.click();
+  const divider = page.locator('#messages-area .unread-divider');
+  await expect(divider).toHaveText('New messages');
+  await expect(page.locator('#messages-area .msg').filter({ hasText: 'Unread anchor arrival' })).toBeVisible();
+  // The thread opens anchored at the first unread message, not at the
+  // bottom: the anchor is the last message, so content stays below it.
+  await expect.poll(() => page.locator('#messages-area').evaluate(
+    el => el.scrollHeight - el.scrollTop - el.clientHeight,
+  )).toBeGreaterThan(0);
+  // The anchored message is on screen, so it is marked read: the badge and
+  // the title clear without leaving the thread.
+  await expect(pagedRow.locator('.convo-unread')).toHaveCount(0);
+  await expect.poll(() => titleUnreadTotal(page)).toBe(unreadBefore);
+});
