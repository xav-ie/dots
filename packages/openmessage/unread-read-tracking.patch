+// localMessageSendQuery reads the newest outbox row's state and the first
+// row's idempotency key for one local message, both over
+// outbox_local_message_idx.
+const localMessageSendQuery = `
+	SELECT state,
+		(SELECT first.idempotency_key
+			FROM outbox AS first
+			WHERE first.account_id = latest.account_id
+				AND first.local_message_id = latest.local_message_id
+			ORDER BY first.created_at_ms ASC, first.outbox_id ASC
+			LIMIT 1)
+	FROM outbox AS latest
+	WHERE latest.account_id = ? AND latest.local_message_id = ?
+	ORDER BY latest.created_at_ms DESC, latest.outbox_id DESC
+	LIMIT 1
+`
+
+// LocalMessageSend returns, for an optimistic outgoing message, the delivery
+// state of its newest outbox row and the idempotency key its first send was
+// submitted with. A client keys its optimistic copy by that key, so it can
+// recognize the stored message as the same send even after SendAgain linked
+// later attempts. ok is false when the message has no outbox row.
+func (r *OutboxRepository) LocalMessageSend(
+	ctx context.Context,
+	accountID, localMessageID string,
+) (state OutboxState, idempotencyKey string, ok bool, err error) {
+	var value, key string
+	scanErr := r.store.db.QueryRowContext(
+		ctx, localMessageSendQuery, accountID, localMessageID,
+	).Scan(&value, &key)
+	if errors.Is(scanErr, sql.ErrNoRows) {
+		return "", "", false, nil
+	}
+	if scanErr != nil {
+		return "", "", false, fmt.Errorf(
+			"outbox send for message %q (account %q): %w",
+			localMessageID,
+			accountID,
+			scanErr,
+		)
+	}
+	return OutboxState(value), key, true, nil
+}
