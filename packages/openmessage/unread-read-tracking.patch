+// MarkConversationReadThrough marks read the incoming messages up to
+// throughMS, leaving later ones unread, or the whole thread when throughMS is
+// 0. The count only ever drops, so a stale call never marks messages unread.
+func (s *Store) MarkConversationReadThrough(id string, throughMS int64) error {
+	if throughMS <= 0 {
+		return s.MarkConversationRead(id)
+	}
+	_, err := s.db.Exec(`
+		UPDATE conversations SET unread_count = MIN(unread_count, (
+			SELECT COUNT(*) FROM messages
+			WHERE messages.conversation_id = conversations.conversation_id
+				AND messages.is_from_me = 0
+				AND messages.timestamp_ms > ?
+		))
+		WHERE conversation_id = ?`, throughMS, id)
+	return err
+}
