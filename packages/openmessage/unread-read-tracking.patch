+test('keeps one bubble element from Sending through Read, patching only its status', async ({ page, request }) => {
+  const outbound = `Steady send ${Date.now()}`;
+
+  await openConversation(page, 'Sarah Chen');
+  await page.locator('#compose-input').fill(outbound);
+  await page.evaluate((text) => {
+    window.__sendBubbleRemovals = 0;
+    window.__sendBubbleStatuses = [];
+    const area = document.getElementById('messages-area');
+    new MutationObserver((records) => {
+      for (const record of records) {
+        for (const node of record.removedNodes) {
+          // Only the bubble itself staying mounted matters; its inner
+          // content is swapped in place once, when the optimistic copy is
+          // adopted by the stored message.
+          if (node.nodeType === 1 && node.matches('.msg') && (node.textContent || '').includes(text)) window.__sendBubbleRemovals++;
+        }
+      }
+      const bubble = Array.from(area.querySelectorAll('.msg.sent')).find(el => (el.textContent || '').includes(text));
+      if (!bubble) return;
+      if (!window.__sendBubble) window.__sendBubble = bubble;
+      if (window.__sendBubble !== bubble) window.__sendBubbleReplaced = true;
+      const status = bubble.querySelector('.msg-status');
+      const kind = status ? status.className.replace('msg-status', '').trim() : '';
+      if (window.__sendBubbleStatuses[window.__sendBubbleStatuses.length - 1] !== kind) window.__sendBubbleStatuses.push(kind);
+    }).observe(area, { childList: true, subtree: true, attributes: true });
+  }, outbound);
+  await page.locator('#compose-input').fill(outbound);
+  // Text sends only leave the outbox when a bridge accepts them; script the
+  // google bridge (Sarah Chen is RCS) to accept this one. The scripted
+  // adapter fails a send fast when nothing is queued, so this must happen
+  // before clicking send, not after.
+  await request.post('/_e2e/bridges/google-primary/next-result', {
+    data: { next_result: 'success' },
+  });
+  await page.locator('#send-btn').click();
+
+  const bubble = page.locator('#messages-area .msg.sent').filter({ hasText: outbound });
+  await expect(bubble.locator('.msg-status.status-sent')).toBeVisible();
+  const { messageID, conversationID } = await bubble.evaluate((el) => ({
+    messageID: el.dataset.msgId,
+    conversationID: new URLSearchParams(window.location.search).get('conversation'),
+  }));
+  expect(messageID).not.toMatch(/^tmp_/);
+  await request.post('/_e2e/read-receipt', { data: { message_id: messageID, conversation_id: conversationID } });
+  await expect(bubble.locator('.msg-status.status-read')).toBeVisible();
+  await expect(bubble.locator('.msg-status svg')).toHaveCount(1);
+
+  const result = await page.evaluate(() => ({
+    removals: window.__sendBubbleRemovals,
+    replaced: !!window.__sendBubbleReplaced,
+    statuses: window.__sendBubbleStatuses,
+    animation: getComputedStyle(window.__sendBubble).animationName,
+  }));
+  expect(result.removals).toBe(0);
+  expect(result.replaced).toBe(false);
+  expect(result.statuses).toContain('status-sending');
+  expect(result.statuses[result.statuses.length - 1]).toBe('status-read');
+});
+
+// Total unread in the document title, 0 when it carries no count.
+async function titleUnreadTotal(page) {
+  const match = /\((\d+)\)\s/.exec(await page.title());
+  return match ? Number(match[1]) : 0;
+}
