diff --git a/macos/OpenMessage/Sources/ContentView.swift b/macos/OpenMessage/Sources/ContentView.swift
index 429e47e..e58b4a8 100644
--- a/macos/OpenMessage/Sources/ContentView.swift
+++ b/macos/OpenMessage/Sources/ContentView.swift
@@ -119,8 +119,11 @@ struct WebViewContainer: NSViewRepresentable {
         context.coordinator.backend = backend
         context.coordinator.notifications = notifications
         context.coordinator.contacts = contacts
-        // Only reload if URL changed
-        if webView.url != url {
+        // Reload only when the backend moved. The loaded URL never equals
+        // baseURL exactly (WebKit adds a trailing slash and the UI keeps the
+        // open conversation in the query), and every SwiftUI update lands
+        // here, so comparing whole URLs reloaded the page and dropped drafts.
+        if webView.url?.host != url.host || webView.url?.port != url.port {
             webView.load(URLRequest(url: url))
         }
     }
