+// markAdoptedBinding records on a conversation row that its remote ID
+// binding was adopted from a bare incoming message (sender matched an
+// existing direct thread) rather than from a conversation snapshot, so a
+// later contradicting snapshot may move the binding off instead of skipping
+// the thread forever.
+func (w *Worker) markAdoptedBinding(conversation *sqlite.Conversation) error {
+	metadata, changed, err := sqlite.WithConversationAdoptedBinding(conversation.MetadataJSON, true)
+	if err != nil {
+		return err
+	}
+	if !changed {
+		return nil
+	}
+	conversation.MetadataJSON = metadata
+	return w.store.UpsertConversation(*conversation)
+}
