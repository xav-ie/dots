+	}
+	nowMS, err := w.nowMS()
+	if err != nil {
+		return historyHealNone, err
+	}
+	w.logger.Info().
+		Str("account_id", accountID).
+		Str("remote_conversation_id", remoteID).
+		Str("conversation_id", bound.ConversationID).
+		Msg("ingest: snapshot contradicts message-adopted binding; displacing it so the group thread can be placed")
+	if _, err := w.store.DisplaceConversationRemoteID(accountID, remoteID, nowMS); err != nil {
+		return historyHealNone, err
+	}
+	stored, getErr := w.store.GetConversation(bound.ConversationID)
+	if getErr != nil {
+		return historyHealNone, getErr
+	}
+	metadata, changed, metaErr := sqlite.WithConversationAdoptedBinding(stored.MetadataJSON, false)
+	if metaErr != nil {
+		return historyHealNone, metaErr
+	}
+	if changed {
+		stored.MetadataJSON = metadata
+		if upErr := w.store.UpsertConversation(stored); upErr != nil {
+			return historyHealNone, upErr
+		}
+	}
+	return historyHealMigrated, nil
 }
 
