@@ -0,0 +1,92 @@
+package sqlite
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+// conversationMintKey holds, in a conversation's metadata_json, that its kind
+// was recorded from a bare message frame rather than a conversation snapshot.
+// Message events carry no conversation kind, so a minted thread defaults to
+// direct; a Google group MMS born ahead of its conversation snapshot takes
+// that shape. The first snapshot that refreshes the row clears the key.
+const conversationMintKey = "mint"
+
+// ConversationMintMessage marks a thread whose kind came from a message frame.
+const ConversationMintMessage = "message"
+
+// conversationAdoptedKey holds, in a conversation's metadata_json, that the
+// row's current remote conversation ID binding was adopted from a bare
+// incoming message (sender matched an existing direct thread) rather than
+// from a conversation snapshot. A snapshot that contradicts an adopted
+// binding may move it off; a snapshot refresh clears the key.
+const conversationAdoptedKey = "adopted"
+
+// ConversationMintSource returns the mint source stored in a conversation's
+// metadata_json, or "" when the kind was snapshot-born or has since been
+// confirmed by a snapshot.
+func ConversationMintSource(metadataJSON string) string {
+	var metadata map[string]any
+	if json.Unmarshal([]byte(metadataJSON), &metadata) != nil {
+		return ""
+	}
+	mint, _ := metadata[conversationMintKey].(string)
+	return mint
+}
+
+// ConversationAdoptedBinding reports whether the conversation's current
+// remote ID binding was adopted from a bare message frame.
+func ConversationAdoptedBinding(metadataJSON string) bool {
+	var metadata map[string]any
+	if json.Unmarshal([]byte(metadataJSON), &metadata) != nil {
+		return false
+	}
+	adopted, _ := metadata[conversationAdoptedKey].(string)
+	return adopted == ConversationMintMessage
+}
+
+// WithConversationMintSource returns metadataJSON with its mint source set
+// ("" removes the key), and whether it changed.
+func WithConversationMintSource(metadataJSON, mint string) (string, bool, error) {
+	return withConversationMetadataKey(metadataJSON, conversationMintKey, mint)
+}
+
+// WithConversationAdoptedBinding returns metadataJSON with the adopted-binding
+// marker set (false removes the key), and whether it changed.
+func WithConversationAdoptedBinding(metadataJSON string, adopted bool) (string, bool, error) {
+	value := ""
+	if adopted {
+		value = ConversationMintMessage
+	}
+	return withConversationMetadataKey(metadataJSON, conversationAdoptedKey, value)
+}
+
+// withConversationMetadataKey sets key to value ("" removes the key) in a
+// conversation's metadata_json, preserving unrelated keys, and reports whether
+// anything changed.
+func withConversationMetadataKey(metadataJSON, key, value string) (string, bool, error) {
+	metadata := map[string]any{}
+	if strings.TrimSpace(metadataJSON) != "" {
+		if err := json.Unmarshal([]byte(metadataJSON), &metadata); err != nil {
+			return "", false, fmt.Errorf("conversation metadata: %w", err)
+		}
+		if metadata == nil {
+			metadata = map[string]any{}
+		}
+	}
+	current, _ := metadata[key].(string)
+	if current == value {
+		return metadataJSON, false, nil
+	}
+	if value == "" {
+		delete(metadata, key)
+	} else {
+		metadata[key] = value
+	}
+	encoded, err := json.Marshal(metadata)
+	if err != nil {
+		return "", false, fmt.Errorf("conversation metadata: %w", err)
+	}
+	return string(encoded), true, nil
+}
