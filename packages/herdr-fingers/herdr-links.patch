+/// Herdr's links win: a regex match touching any cell of one is dropped, so an
+/// app-wrapped URL gets one hint for the whole destination rather than a hint
+/// per row (or a number hint inside its tail).
+fn merge_herdr_links(
+    candidates: Vec<Candidate>,
+    links: Vec<Candidate>,
+    mode: HerdrLinks,
+) -> Vec<Candidate> {
+    let links: Vec<Candidate> = links
+        .into_iter()
+        .filter(|link| mode == HerdrLinks::All || link.pattern == "url")
+        .collect();
+    let overlaps = |a: &Candidate, b: &Candidate| {
+        a.segments.iter().any(|x| {
+            b.segments
+                .iter()
+                .any(|y| x.row == y.row && x.col < y.col + y.width && y.col < x.col + x.width)
+        })
+    };
+    let mut merged: Vec<Candidate> = candidates
+        .into_iter()
+        .filter(|candidate| !links.iter().any(|link| overlaps(candidate, link)))
+        .collect();
+    merged.extend(links);
+    merged.sort_by_key(|c| (c.first_row(), c.first_col()));
+    merged
+}
