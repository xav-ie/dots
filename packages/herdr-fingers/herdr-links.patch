+/// One `pane.links` entry as a candidate: `url` links copy their destination,
+/// `path` links the absolute path Herdr resolved.
+fn candidate_from_link(link: &Value) -> Option<Candidate> {
+    let (text, pattern) = match (link["url"].as_str(), link["path"].as_str()) {
+        (Some(url), _) => (url, "url"),
+        (None, Some(path)) => (path, "path"),
+        (None, None) => return None,
+    };
+    let segments: Vec<Segment> = link["regions"]
+        .as_array()?
+        .iter()
+        .filter_map(|region| {
+            let row = usize::try_from(region["row"].as_u64()?).ok()?;
+            let start = u16::try_from(region["start_col"].as_u64()?).ok()?;
+            let end = u16::try_from(region["end_col"].as_u64()?).ok()?;
+            (end >= start).then_some(Segment {
+                row,
+                col: start,
+                width: end - start + 1,
+            })
+        })
+        .collect();
+    (!segments.is_empty()).then(|| Candidate {
+        text: text.to_string(),
+        pattern: pattern.to_string(),
+        segments,
+    })
+}
+
